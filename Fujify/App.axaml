<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fujify.App"
             xmlns:local="using:Fujify"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Semantic App Theme Brushes: Studio Purple & Reduced Glass Design System -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0E1016"/>
        <SolidColorBrush x:Key="AppSolidBackgroundBrush" Color="#FF0E1016"/>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF20212B"/>
        <SolidColorBrush x:Key="AppSurfaceSecondaryBrush" Color="#FF2A2933"/>
        <SolidColorBrush x:Key="AppHeaderBrush" Color="#FF0E1016"/>
        <SolidColorBrush x:Key="AppSolidHeaderBrush" Color="#FF0E1016"/>
        <SolidColorBrush x:Key="AppFooterBrush" Color="#FF14151E"/>
        <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFEDE8F5"/>
        <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FFA6A7B8"/>
        <SolidColorBrush x:Key="AppTextMutedBrush" Color="#FF7E7E93"/>
        <SolidColorBrush x:Key="AppGlassPillBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="AppAccentBrush" Color="#FFC2ACEB"/>
        <SolidColorBrush x:Key="AppAccentLightBrush" Color="#FFE3D6FF"/>
        <SolidColorBrush x:Key="AppEdgeBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="AppPrimaryBtnBgBrush" Color="#FFFAF9FC"/>
        <SolidColorBrush x:Key="AppPrimaryBtnFgBrush" Color="#FF252332"/>
        <SolidColorBrush x:Key="AppSelectedRowBrush" Color="#1ECCB6FF"/>
        <SolidColorBrush x:Key="AppSelectedBorderBrush" Color="#4ECCB6FF"/>
        <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>

        <!-- Global FluentTheme Accent Color Overrides: Constant Purple Palette -->
        <Color x:Key="SystemAccentColor">#FFC2ACEB</Color>
        <Color x:Key="SystemAccentColorLight1">#FFE3D6FF</Color>
        <Color x:Key="SystemAccentColorLight2">#FFF0E8FF</Color>
        <Color x:Key="SystemAccentColorLight3">#FFF8F4FF</Color>
        <Color x:Key="SystemAccentColorDark1">#FF9679BC</Color>
        <Color x:Key="SystemAccentColorDark2">#FF7351B5</Color>
        <Color x:Key="SystemAccentColorDark3">#FF523886</Color>
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FFC2ACEB"/>
        <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#1ECCB6FF"/>
        <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#2ECCB6FF"/>
        <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#4ECCB6FF"/>

        <!-- ToggleSwitch Theme Palette (Solid Grey Track & Lighter Thin Border when Off) -->
        <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FF353745"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FF5A5C70"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FF404254"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#FF72748C"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#FF2E303D"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#FF5A5C70"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#FF282933"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#FF404250"/>

        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF8474AC"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FFBFA6ED"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF9679BC"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FFD5BDFF"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF735FA0"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FFBFA6ED"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#FF52466E"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="#FF756598"/>

        <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFD1CCE0"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFB8B4C8"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#FF706C7A"/>

        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFE0DEE8"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#FFC0B8D0"/>

        <Thickness x:Key="ToggleSwitchOuterBorderStrokeThickness">1</Thickness>
        <Thickness x:Key="ToggleSwitchOnStrokeThickness">1</Thickness>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- Seamless DataGrid Header & Queue Styling -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        </Style>
        <Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AreSeparatorsVisible" Value="False"/>
            <Setter Property="SeparatorBrush" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridColumnHeadersPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridColumnHeader /template/ Border#HeaderBorder">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridColumnHeader /template/ Grid#PART_ColumnHeaderRoot">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridColumnHeader /template/ Rectangle#VerticalSeparator">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridColumnHeader /template/ Rectangle#PART_Separator">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover /template/ Grid#PART_ColumnHeaderRoot">
            <Setter Property="Background" Value="{DynamicResource AppGlassPillBrush}"/>
        </Style>

        <!-- DataGrid Cell Styling (No Focus Border Adorner) -->
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridCell /template/ Rectangle#FocusBounds">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:focus /template/ Rectangle#FocusBounds">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell /template/ Grid#FocusBounds">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:focus /template/ Grid#FocusBounds">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell /template/ Border#FocusBounds">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:focus /template/ Border#FocusBounds">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:focus">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridCell:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridCell:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- DataGrid Row Styling (Floating Pill Shape matching Mockup) -->
        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="8,2.5"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="MinHeight" Value="66"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="DataGridRow /template/ Rectangle#BackgroundRectangle">
            <Setter Property="RadiusX" Value="12"/>
            <Setter Property="RadiusY" Value="12"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="Transparent"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#0AFFFFFF"/>
            <Setter Property="Stroke" Value="#18FFFFFF"/>
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="#1ECCB6FF"/>
            <Setter Property="BorderBrush" Value="#4ECCB6FF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#1ECCB6FF"/>
            <Setter Property="Stroke" Value="#4ECCB6FF"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover">
            <Setter Property="Background" Value="#2ECCB6FF"/>
            <Setter Property="BorderBrush" Value="#6ECCB6FF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#2ECCB6FF"/>
            <Setter Property="Stroke" Value="#6ECCB6FF"/>
        </Style>

        <!-- View Mode Segmented Toggle Buttons (List vs Grid) -->
        <Style Selector="Button.view-toggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.view-toggle.active">
            <Setter Property="Background" Value="#34343F"/>
            <Setter Property="Foreground" Value="#EEEAF8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Studio Primary Action Button (White/Cream Pill with Dark Text, Uncompromised White Hover) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#FFFAF9FC"/>
            <Setter Property="Foreground" Value="#FF252332"/>
            <Setter Property="BorderBrush" Value="#B3FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFAF9FC"/>
            <Setter Property="Foreground" Value="#FF252332"/>
            <Setter Property="BorderBrush" Value="#B3FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="Foreground" Value="#FF252332"/>
            <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="Foreground" Value="#FF252332"/>
            <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFE5E3F3"/>
            <Setter Property="Foreground" Value="#FF252332"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#80FAF9FC"/>
            <Setter Property="Foreground" Value="#66252332"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <!-- Studio Secondary Action Button (Translucent Pill) -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>
        <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
        </Style>
        <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>

        <!-- Accent Button -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="#252332"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Windows Standard Caption Buttons (Minimize, Maximize, Close) -->
        <Style Selector="Button.win-caption">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.win-caption /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.win-caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>
        <Style Selector="Button.win-caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="Button.win-caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>
        <Style Selector="Button.win-caption.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C4101E"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>

        <!-- Navigation Rail Buttons -->
        <Style Selector="Button.nav">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Padding" Value="4,8"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#0DFFFFFF"/>
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#16CCB6FF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppEdgeBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentLightBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Step Workflow Indicators -->
        <Style Selector="StackPanel.step-item">
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.step-item Border.step-badge">
            <Setter Property="Background" Value="{DynamicResource AppGlassPillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="StackPanel.step-item TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        </Style>
        <Style Selector="StackPanel.step-item.current">
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="StackPanel.step-item.current Border.step-badge">
            <Setter Property="Background" Value="#22B89BE4"/>
            <Setter Property="BorderBrush" Value="#33D4B9FF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="StackPanel.step-item.current TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentLightBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Studio Reduced Glass Panel (23px Rounded Bordered Card) -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="23"/>
            <Setter Property="BoxShadow" Value="0 8 24 0 #28000000"/>
        </Style>

        <!-- Seamless Inspector Panel (No Outer Border) -->
        <Style Selector="Border.inspector">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BoxShadow" Value="none"/>
        </Style>

        <!-- Inspector Tab Buttons (Seamless hover underline) -->
        <Style Selector="Button.tab-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tab-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.tab-btn:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.tab-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.tab-btn:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.tab-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.tab-btn TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tab-btn:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.tab-btn.active TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentLightBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- Studio Context Menu & Menu Items -->
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="#FF20212B"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Separator">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,4"/>
        </Style>

        <!-- Simulation Chips -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#292834"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style Selector="Border.chip.chosen">
            <Setter Property="Background" Value="#393044"/>
            <Setter Property="BorderBrush" Value="#42C4A8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Dynamic Accent Integration -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- ToggleSwitch Solid Grey Off / Purple On Aesthetic with Light Grey Border -->
        <Style Selector="ToggleSwitch /template/ Border#OuterBorder">
            <Setter Property="Background" Value="#353745"/>
            <Setter Property="BorderBrush" Value="#5A5C70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="ToggleSwitch:unchecked /template/ Border#OuterBorder">
            <Setter Property="Background" Value="#353745"/>
            <Setter Property="BorderBrush" Value="#5A5C70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="ToggleSwitch:unchecked:pointerover /template/ Border#OuterBorder">
            <Setter Property="Background" Value="#404254"/>
            <Setter Property="BorderBrush" Value="#72748C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ToggleSwitch:pointerover /template/ Border#OuterBorder">
            <Setter Property="Background" Value="#404254"/>
            <Setter Property="BorderBrush" Value="#72748C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ Border#OuterBorder">
            <Setter Property="Background" Value="#8474AC"/>
            <Setter Property="BorderBrush" Value="#BFA6ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#OuterBorder">
            <Setter Property="Background" Value="#9679BC"/>
            <Setter Property="BorderBrush" Value="#D5BDFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ToggleSwitch:disabled /template/ Border#OuterBorder">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="ToggleSwitch /template/ Border#SwitchKnobBounds">
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="ToggleSwitch:unchecked /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#8474AC"/>
            <Setter Property="BorderBrush" Value="#BFA6ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#9679BC"/>
            <Setter Property="BorderBrush" Value="#D5BDFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ToggleSwitch /template/ Ellipse#SwitchKnobOff">
            <Setter Property="Fill" Value="#D1CCE0"/>
        </Style>
        <Style Selector="ToggleSwitch:pointerover /template/ Ellipse#SwitchKnobOff">
            <Setter Property="Fill" Value="#FFFFFF"/>
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
            <Setter Property="Fill" Value="#FFFFFF"/>
        </Style>

        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- Foldable Quick Settings Box Styles & Animations -->
        <Style Selector="Border.foldable-box">
            <Setter Property="MaxHeight" Value="600"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="MaxHeight" Duration="0:0:0.32" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.foldable-box.collapsed">
            <Setter Property="MaxHeight" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="TextBlock.fold-chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.fold-chevron.collapsed">
            <Setter Property="RenderTransform" Value="rotate(-90deg)"/>
        </Style>
    </Application.Styles>
</Application>
