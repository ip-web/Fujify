<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Fujify.App"
             xmlns:local="using:Fujify"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Semantic App Theme Brushes: Studio Purple & Reduced Glass Design System -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0E1016"/>
        <SolidColorBrush x:Key="AppSolidBackgroundBrush" Color="#FF0E1016"/>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF20212B"/>
        <SolidColorBrush x:Key="AppSurfaceSecondaryBrush" Color="#FF2A2933"/>
        <SolidColorBrush x:Key="AppHeaderBrush" Color="#FF0E1016"/>
        <SolidColorBrush x:Key="AppSolidHeaderBrush" Color="#FF0E1016"/>
        <SolidColorBrush x:Key="AppFooterBrush" Color="#FF14151E"/>
        <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFEDE8F5"/>
        <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FFA6A7B8"/>
        <SolidColorBrush x:Key="AppTextMutedBrush" Color="#FF7E7E93"/>
        <SolidColorBrush x:Key="AppGlassPillBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="AppAccentBrush" Color="#FFC2ACEB"/>
        <SolidColorBrush x:Key="AppAccentLightBrush" Color="#FFE3D6FF"/>
        <SolidColorBrush x:Key="AppEdgeBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="AppPrimaryBtnBgBrush" Color="#FFFAF9FC"/>
        <SolidColorBrush x:Key="AppPrimaryBtnFgBrush" Color="#FF252332"/>
        <SolidColorBrush x:Key="AppSelectedRowBrush" Color="#14CCB6FF"/>
        <SolidColorBrush x:Key="AppSelectedBorderBrush" Color="#2ECCB6FF"/>
        <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- Seamless DataGrid Header & Queue Styling -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        </Style>
        <Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AreSeparatorsVisible" Value="False"/>
            <Setter Property="SeparatorBrush" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridColumnHeadersPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridColumnHeader /template/ Border#HeaderBorder">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridColumnHeader /template/ Grid#PART_ColumnHeaderRoot">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridColumnHeader /template/ Rectangle#VerticalSeparator">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridColumnHeader /template/ Rectangle#PART_Separator">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover /template/ Grid#PART_ColumnHeaderRoot">
            <Setter Property="Background" Value="{DynamicResource AppGlassPillBrush}"/>
        </Style>

        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="MinHeight" Value="66"/>
        </Style>
        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="{DynamicResource AppSelectedRowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppSelectedBorderBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected:pointerover">
            <Setter Property="Background" Value="#1ECCB6FF"/>
            <Setter Property="BorderBrush" Value="#44CCB6FF"/>
        </Style>

        <!-- View Mode Segmented Toggle Buttons (List vs Grid) -->
        <Style Selector="Button.view-toggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.view-toggle.active">
            <Setter Property="Background" Value="#34343F"/>
            <Setter Property="Foreground" Value="#EEEAF8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Micro-interactions & Smooth Transitions -->
        <Style Selector="Button">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.90"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <!-- Studio Primary Action Button (White/Cream Pill with Dark Text) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AppPrimaryBtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBtnFgBrush}"/>
            <Setter Property="BorderBrush" Value="#B3FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
        </Style>

        <!-- Studio Secondary Action Button (Translucent Pill) -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
        </Style>

        <!-- Accent Button -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="#252332"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Custom Titlebar Dot Buttons matching mockup -->
        <Style Selector="Button.titlebar-dot">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.titlebar-dot:pointerover">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="Foreground" Value="#C2ACEB"/>
        </Style>
        <Style Selector="Button.titlebar-dot.close:pointerover">
            <Setter Property="Background" Value="#66FF5555"/>
            <Setter Property="BorderBrush" Value="#99FF5555"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Navigation Rail Buttons -->
        <Style Selector="Button.nav">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#0DFFFFFF"/>
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#16CCB6FF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppEdgeBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentLightBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Step Workflow Indicators -->
        <Style Selector="StackPanel.step-item">
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.step-item Border.step-badge">
            <Setter Property="Background" Value="{DynamicResource AppGlassPillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="StackPanel.step-item TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        </Style>
        <Style Selector="StackPanel.step-item.current">
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="StackPanel.step-item.current Border.step-badge">
            <Setter Property="Background" Value="#22B89BE4"/>
            <Setter Property="BorderBrush" Value="#33D4B9FF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="StackPanel.step-item.current TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentLightBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Studio Reduced Glass Panel (23px Rounded Bordered Card) -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="23"/>
            <Setter Property="BoxShadow" Value="0 8 24 0 #28000000"/>
        </Style>

        <!-- Seamless Inspector Panel (No Outer Border) -->
        <Style Selector="Border.inspector">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BoxShadow" Value="none"/>
        </Style>

        <!-- Inspector Tab Buttons (Seamless hover underline) -->
        <Style Selector="Button.tab-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tab-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tab-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tab-btn TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tab-btn:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.tab-btn.active TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentLightBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- Studio Context Menu & Menu Items -->
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="#FF20212B"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppEdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Separator">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,4"/>
        </Style>

        <!-- Simulation Chips -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#292834"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style Selector="Border.chip.chosen">
            <Setter Property="Background" Value="#393044"/>
            <Setter Property="BorderBrush" Value="#42C4A8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Dynamic Accent Integration -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- ToggleSwitch Solid Grey Off / Purple On Aesthetic -->
        <Style Selector="ToggleSwitch /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#353745"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="ToggleSwitch:unchecked /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#353745"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleSwitch:unchecked:pointerover /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#3F4152"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleSwitch:pointerover /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#3F4152"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#8474AC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#9679BC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
            <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- Foldable Quick Settings Box Styles & Animations -->
        <Style Selector="Border.foldable-box">
            <Setter Property="MaxHeight" Value="600"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="MaxHeight" Duration="0:0:0.32" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.foldable-box.collapsed">
            <Setter Property="MaxHeight" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="TextBlock.fold-chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.fold-chevron.collapsed">
            <Setter Property="RenderTransform" Value="rotate(-90deg)"/>
        </Style>
    </Application.Styles>
</Application>
