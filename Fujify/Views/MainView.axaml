<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fujify.ViewModels;assembly=Fujifier"
             xmlns:models="clr-namespace:Fujify.Models;assembly=Fujifier"
             x:Class="Fujify.Views.MainView"
             x:DataType="vm:MainViewModel"
             TopLevel.AutoSafeAreaPadding="False"
             DragDrop.AllowDrop="True">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Delete" Command="{Binding RemoveFileCommand}" CommandParameter="{Binding SelectedFile}"/>
    </UserControl.KeyBindings>

    <Grid Background="{DynamicResource AppBackgroundBrush}" ClipToBounds="True">
        <!-- AMBIENT PURPLE & TEAL GLOW ACCENTS (Desktop/Tablet Studio) -->
        <Canvas IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                IsVisible="{Binding IsTabletOrDesktopLayout}">
            <!-- Top-Right Smooth Ambient Glow (~80% width, soft dark purple tint matching Settings window) -->
            <Ellipse Width="950" Height="650" Canvas.Right="-100" Canvas.Top="-100" Opacity="0.22">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="60%,35%" GradientOrigin="60%,35%" RadiusX="55%" RadiusY="55%">
                        <GradientStop Color="#3E1D60" Offset="0.0"/>
                        <GradientStop Color="#2C1445" Offset="0.30"/>
                        <GradientStop Color="#1D0E30" Offset="0.60"/>
                        <GradientStop Color="#000E1016" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Bottom-Left Subtle Teal Ambient Glow -->
            <Ellipse Width="850" Height="600" Canvas.Left="-180" Canvas.Bottom="-180" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#FF1F4844" Offset="0.0"/>
                        <GradientStop Color="#B31A3D39" Offset="0.35"/>
                        <GradientStop Color="#66142F2D" Offset="0.65"/>
                        <GradientStop Color="#000E1016" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- BASE APP INTERFACE -->
        <Grid RowDefinitions="Auto,*">

            <!-- 1. TOP TITLEBAR (Custom Seamless Studio Titlebar for Desktop/Tablet) -->
            <Border x:Name="HeaderBar" Grid.Row="0"
                    IsVisible="{Binding IsTabletOrDesktopLayout}"
                    Background="Transparent"
                    BorderThickness="0"
                    MinHeight="34"
                    Padding="16,0,0,0"
                    ZIndex="100">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Stretch">
                    <!-- Left: Studio Logo & Title (Draggable) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                Background="Transparent"
                                PointerPressed="TitleBar_PointerPressed"
                                DoubleTapped="TitleBar_DoubleTapped">
                        <Image Source="/Assets/images/logoXL.png" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock Text="Fujifier — Film simulation engine" FontSize="11" Foreground="#8C8A9F" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </StackPanel>

                    <!-- Center: Draggable Spacer -->
                    <Panel Grid.Column="1" Background="Transparent"
                           PointerPressed="TitleBar_PointerPressed"
                           DoubleTapped="TitleBar_DoubleTapped"/>

                    <!-- Right: Custom Functional Minimize, Maximize, Close Buttons matching standard Windows controls -->
                    <StackPanel x:Name="CaptionButtonsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Stretch" HorizontalAlignment="Right"
                                IsVisible="{Binding ShowCaptionButtons}">
                        <!-- Minimize Button -->
                        <Button x:Name="TitleBarMinimizeButton" Classes="win-caption" Click="TitleBar_Minimize_Click" ToolTip.Tip="Minimize">
                            <TextBlock Text="&#x2014;" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                        </Button>
                        <!-- Maximize / Restore Button -->
                        <Button x:Name="TitleBarMaximizeButton" Classes="win-caption" Click="TitleBar_Maximize_Click" ToolTip.Tip="Maximize">
                            <TextBlock Text="&#x25A2;" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                        </Button>
                        <!-- Close Button -->
                        <Button x:Name="TitleBarCloseButton" Classes="win-caption close" Click="TitleBar_Close_Click" ToolTip.Tip="Close">
                            <TextBlock Text="&#x2715;" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MAIN BODY (PHONE LAYOUT vs DESKTOP BATCH STUDIO LAYOUT) -->
            <Grid Grid.Row="1">

                <!-- A. PHONE LAYOUT (Touch-First Cards, Single Column with Foldable Bottom Menu) -->
                <Grid IsVisible="{Binding IsPhoneLayout}">
                    <!-- Base Phone Screen -->
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Row 0: Mobile App Bar (Native mobile header with logo, title, and settings) -->
                        <Border x:Name="PhoneTopBar" Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="16,8,16,4">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <!-- Left: Logo & App Branding -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="8"
                                            Background="{DynamicResource AppSurfaceBrush}"
                                            BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1"
                                            ClipToBounds="True">
                                        <Image Source="/Assets/images/logoXL.png" Width="20" Height="20"
                                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="Fujifier" FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Film Simulation Engine" FontSize="10" FontWeight="Medium"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Center: Draggable Spacer (for narrow desktop window) -->
                                <Panel Grid.Column="1" Background="Transparent"
                                       PointerPressed="TitleBar_PointerPressed"
                                       DoubleTapped="TitleBar_DoubleTapped"/>

                                <!-- Right: Queue Clear + Settings Shortcut + Desktop Caption Controls (if narrow desktop) -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Command="{Binding ClearCommand}"
                                            IsVisible="{Binding HasFiles}"
                                            Classes="secondary" Height="36" Padding="14,0" CornerRadius="18"
                                            Content="Clear" FontSize="11" FontWeight="SemiBold"
                                            VerticalContentAlignment="Center"
                                            ToolTip.Tip="Remove all photos from queue"/>

                                    <Button Command="{Binding OpenPreferencesCommand}"
                                            Classes="secondary" Width="36" Height="36" Padding="0" CornerRadius="18"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            ToolTip.Tip="Settings">
                                        <PathIcon Data="M 12 15 A 3 3 0 1 0 12 9 A 3 3 0 1 0 12 15 M 19.4 15 a 1.65 1.65 0 0 0 .33 1.82 l .06 .06 a 2 2 0 1 1 -2.83 2.83 l -.06 -.06 a 1.65 1.65 0 0 0 -1.82 -.33 1.65 1.65 0 0 0 -1 1.51 V 21 a 2 2 0 1 1 -4 0 v -.09 A 1.65 1.65 0 0 0 9 19.4 a 1.65 1.65 0 0 0 -1.82 .33 l -.06 .06 a 2 2 0 1 1 -2.83 -2.83 l .06 -.06 a 1.65 1.65 0 0 0 .33 -1.82 1.65 1.65 0 0 0 -1.51 -1 H 3 a 2 2 0 1 1 0 -4 h .09 A 1.65 1.65 0 0 0 4.6 9 a 1.65 1.65 0 0 0 -.33 -1.82 l -.06 -.06 a 2 2 0 1 1 2.83 -2.83 l .06 .06 a 1.65 1.65 0 0 0 1.82 .33 H 9 a 1.65 1.65 0 0 0 1 -1.51 V 3 a 2 2 0 1 1 4 0 v .09 a 1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82 -.33 l .06 -.06 a 2 2 0 1 1 2.83 2.83 l -.06 .06 a 1.65 1.65 0 0 0 -.33 1.82 V 9 a 1.65 1.65 0 0 0 1.51 1 H 21 a 2 2 0 1 1 0 4 h -.09 a 1.65 1.65 0 0 0 -1.51 1 Z"
                                                  Width="16" Height="16" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    </Button>

                                    <!-- Optional Desktop Caption Buttons when running on desktop window -->
                                    <StackPanel Orientation="Horizontal" Spacing="0" IsVisible="{Binding ShowCaptionButtons}">
                                        <Button Classes="win-caption" Click="TitleBar_Minimize_Click" Width="32" Height="32" ToolTip.Tip="Minimize">
                                            <TextBlock Text="&#x2014;" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                                        </Button>
                                        <Button Classes="win-caption" Click="TitleBar_Maximize_Click" Width="32" Height="32" ToolTip.Tip="Maximize">
                                            <TextBlock Text="&#x25A2;" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                                        </Button>
                                        <Button Classes="win-caption close" Click="TitleBar_Close_Click" Width="32" Height="32" ToolTip.Tip="Close">
                                            <TextBlock Text="&#x2715;" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 1: Phone File List / Empty State -->
                        <Grid Grid.Row="1">
                            <!-- Empty State -->
                            <ScrollViewer IsVisible="{Binding !HasFiles}" HorizontalScrollBarVisibility="Disabled">
                                <Border Padding="16,8" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="10" HorizontalAlignment="Stretch" MaxWidth="340">
                                        <Border Width="64" Height="64" CornerRadius="32"
                                                Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="📸" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Add RAW Photos to Begin" FontWeight="Bold" FontSize="17"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tap the '+' button below to import RAW files from your camera, SD card, or photo library."
                                                   FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>

                            <!-- Mobile Card List -->
                            <ScrollViewer IsVisible="{Binding HasFiles}" HorizontalScrollBarVisibility="Disabled"
                                          IsScrollInertiaEnabled="True">
                                <ItemsControl ItemsSource="{Binding Files}" Margin="16,6,16,80">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:FileItem">
                                            <Border Classes="mobile-card" Classes.selected="{Binding IsSelected}"
                                                    Margin="0,5" Padding="12" CornerRadius="16"
                                                    Background="{DynamicResource AppSurfaceBrush}"
                                                    BorderBrush="{DynamicResource AppEdgeBrush}"
                                                    BorderThickness="1"
                                                    PointerPressed="MobileCard_PointerPressed"
                                                    DoubleTapped="MobileCard_DoubleTapped"
                                                    Cursor="Hand">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <!-- Thumbnail -->
                                                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="10"
                                                            ClipToBounds="True" Background="{DynamicResource AppSurfaceSecondaryBrush}" VerticalAlignment="Center">
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                    </Border>

                                                    <!-- File Info -->
                                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CameraMakeAndModel}" FontSize="12"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Border HorizontalAlignment="Left" CornerRadius="6" Padding="8,3"
                                                                Background="{DynamicResource AppSurfaceSecondaryBrush}">
                                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{Binding StatusColor}"
                                                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Remove Action -->
                                                    <Button Grid.Column="2" Content="✕"
                                                            Command="{Binding RemoveCommand}"
                                                            CommandParameter="{Binding}"
                                                            Width="32" Height="32" CornerRadius="16"
                                                            Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource AppGlassPillBrush}"
                                                            Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                            BorderThickness="0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Mobile Add Menu Backdrop (Dismisses floating menu when tapped with smooth fade) -->
                            <Border x:Name="MobileAddBackdrop"
                                    Background="#77070A12"
                                    ZIndex="150"
                                    IsHitTestVisible="{Binding IsMobileAddMenuOpen}"
                                    Classes="mobile-fab-backdrop" Classes.open="{Binding IsMobileAddMenuOpen}"
                                    PointerPressed="OnMobileAddBackdropPointerPressed"/>

                            <!-- Mobile Floating Add Button & Speed Dial Menu (Bottom Left) -->
                            <Grid ZIndex="160"
                                  HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                  Margin="20,0,0,20">
                                <!-- Speed Dial Options (Slide & Spring Upwards) -->
                                <StackPanel Orientation="Vertical" Spacing="10"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Margin="0,0,0,68"
                                            IsHitTestVisible="{Binding IsMobileAddMenuOpen}">
                                    <!-- Option: Add Folder -->
                                    <Border Classes="speed-dial-item speed-dial-folder" Classes.open="{Binding IsMobileAddMenuOpen}"
                                            CornerRadius="21" BoxShadow="0 3 10 0 #35000000">
                                        <Button Command="{Binding MobileAddFolderCommand}"
                                                Classes="secondary" Height="42" CornerRadius="21"
                                                Padding="14,0,18,0">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="14"
                                                        Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                        VerticalAlignment="Center">
                                                    <PathIcon Data="M 3 7 V 5 h 7 l 2 3 h 9 v 12 H 3 Z"
                                                              Width="13" Height="13"
                                                              Foreground="{DynamicResource AppAccentBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Add Folder" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>

                                    <!-- Option: Add Files -->
                                    <Border Classes="speed-dial-item speed-dial-files" Classes.open="{Binding IsMobileAddMenuOpen}"
                                            CornerRadius="21" BoxShadow="0 3 10 0 #35000000">
                                        <Button Command="{Binding MobileAddFilesCommand}"
                                                Classes="secondary" Height="42" CornerRadius="21"
                                                Padding="14,0,18,0">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Border Width="28" Height="28" CornerRadius="14"
                                                        Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                        VerticalAlignment="Center">
                                                    <PathIcon Data="M 3 3 h 18 v 18 H 3 Z M 8 8 A 1.5 1.5 0 1 0 8 11 A 1.5 1.5 0 1 0 8 8 M 3 17 l 6 -6 l 4 4 l 3 -3 l 5 5"
                                                              Width="13" Height="13"
                                                              Foreground="{DynamicResource AppAccentBrush}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Add Files" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </StackPanel>

                                <!-- Floating 100% Round Action Button -->
                                <Border Width="56" Height="56" CornerRadius="28"
                                        BoxShadow="0 4 12 0 #40000000"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                    <Button Command="{Binding ToggleMobileAddMenuCommand}"
                                            Classes="fab" Classes.open="{Binding IsMobileAddMenuOpen}"
                                            Width="56" Height="56" CornerRadius="28"
                                            Padding="0"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            ToolTip.Tip="Add photos or folder">
                                        <PathIcon Classes="fab-icon" Classes.open="{Binding IsMobileAddMenuOpen}"
                                                  Data="M 11 4 A 1 1 0 0 1 13 4 V 11 H 20 A 1 1 0 0 1 20 13 H 13 V 20 A 1 1 0 0 1 11 20 V 13 H 4 A 1 1 0 0 1 4 11 H 11 Z"
                                                  Width="20" Height="20"/>
                                    </Button>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Phone Bottom Action Bar with Options Fold Toggle -->
                        <Border x:Name="PhoneBottomBar" Grid.Row="2" Background="{DynamicResource AppFooterBrush}"
                                BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                            <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                <!-- Status & Output Destination Summary (Clickable to fold/unfold sidebar) -->
                                <Button Grid.Column="0" Command="{Binding ToggleMobileSidebarCommand}"
                                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,8,0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand"
                                        ToolTip.Tip="Fold / unfold sidebar options and photo info">
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="#A5D5B7" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding OverallStatusText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding OutputDestinationSummary}" FontSize="9"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>

                                <!-- Sidebar Options Foldable Toggle Button -->
                                <Button Grid.Column="1" Command="{Binding ToggleMobileSidebarCommand}"
                                        Classes="secondary" Height="40" Padding="12,0" Margin="0,0,8,0" CornerRadius="20"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Fold / unfold sidebar menu">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="M 4 21 v -7 M 4 10 V 3 M 12 21 v -9 M 12 8 V 3 M 20 21 v -5 M 20 12 V 3 M 1 14 h 6 M 9 8 h 6 M 17 16 h 6"
                                                  Width="13" Height="13" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Options" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding MobileSidebarChevron}" FontSize="9" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppAccentBrush}"/>
                                    </StackPanel>
                                </Button>

                                <!-- Process Action Button -->
                                <Button Grid.Column="2" Content="{Binding ProcessButtonContent}" Command="{Binding ProcessCommand}"
                                        IsEnabled="{Binding CanProcessOrStop}" Classes="primary"
                                        Height="40" Padding="16,0" FontSize="12" FontWeight="SemiBold" CornerRadius="20"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Foldable Menu Backdrop (Dims background and folds down on tap with smooth fade) -->
                    <Border x:Name="MobileSidebarBackdrop"
                            Background="#99070A12"
                            ZIndex="400"
                            IsHitTestVisible="{Binding IsMobileSidebarOpen}"
                            Classes="sheet-backdrop" Classes.open="{Binding IsMobileSidebarOpen}"
                            PointerPressed="OnMobileSidebarBackdropPointerPressed"/>

                    <!-- Foldable Bottom Sheet / Drawer containing the Full Sidebar (Smooth slide-up transition) -->
                    <Border x:Name="MobileSidebarSheet"
                            ZIndex="401"
                            IsHitTestVisible="{Binding IsMobileSidebarOpen}"
                            Classes="bottom-sheet" Classes.open="{Binding IsMobileSidebarOpen}"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            Margin="0,40,0,0"
                            MaxHeight="540"
                            CornerRadius="22,22,0,0"
                            Background="{DynamicResource AppSolidBackgroundBrush}"
                            BorderBrush="{DynamicResource AppEdgeBrush}"
                            BorderThickness="1,1,1,0"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <!-- 1. Centered Fold Handle -->
                            <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,4"
                                    Width="36" Height="4" CornerRadius="2"
                                    Background="{DynamicResource AppEdgeBrush}"
                                    Cursor="Hand"
                                    PointerPressed="OnMobileSidebarBackdropPointerPressed"/>

                            <!-- 2. Header: Tabs (Settings | Photo info) + Action Controls -->
                            <Border Grid.Row="1" Padding="16,4,16,8" Background="Transparent"
                                    BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <!-- Tabs -->
                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto" HorizontalAlignment="Left">
                                        <!-- Settings Tab Button -->
                                        <Button Grid.Column="0" Command="{Binding SelectInspectorSettingsTabCommand}"
                                                Classes="tab-btn" Classes.active="{Binding IsInspectorSettingsTab}"
                                                Margin="0,0,12,0" Padding="8,6">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Text="Settings" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <Border Height="2" Width="48" Background="{DynamicResource AppAccentBrush}"
                                                        IsVisible="{Binding IsInspectorSettingsTab}"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Photo info Tab Button -->
                                        <Button Grid.Column="1" Command="{Binding SelectInspectorInfoTabCommand}"
                                                Classes="tab-btn" Classes.active="{Binding IsInspectorInfoTab}"
                                                Padding="8,6">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Text="Photo info" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <Border Height="2" Width="48" Background="{DynamicResource AppAccentBrush}"
                                                        IsVisible="{Binding IsInspectorInfoTab}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Right Actions: Preferences Button + Fold Down Button -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <!-- Preferences Cog Button -->
                                        <Button Command="{Binding OpenPreferencesCommand}"
                                                Classes="secondary" Width="30" Height="30" CornerRadius="15" Padding="0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                ToolTip.Tip="Application Settings">
                                            <PathIcon Data="M 12 15 A 3 3 0 1 0 12 9 A 3 3 0 1 0 12 15 M 19.4 15 a 1.65 1.65 0 0 0 .33 1.82 l .06 .06 a 2 2 0 1 1 -2.83 2.83 l -.06 -.06 a 1.65 1.65 0 0 0 -1.82 -.33 1.65 1.65 0 0 0 -1 1.51 V 21 a 2 2 0 1 1 -4 0 v -.09 A 1.65 1.65 0 0 0 9 19.4 a 1.65 1.65 0 0 0 -1.82 .33 l -.06 .06 a 2 2 0 1 1 -2.83 -2.83 l .06 -.06 a 1.65 1.65 0 0 0 .33 -1.82 1.65 1.65 0 0 0 -1.51 -1 H 3 a 2 2 0 1 1 0 -4 h .09 A 1.65 1.65 0 0 0 4.6 9 a 1.65 1.65 0 0 0 -.33 -1.82 l -.06 -.06 a 2 2 0 1 1 2.83 -2.83 l .06 .06 a 1.65 1.65 0 0 0 1.82 .33 H 9 a 1.65 1.65 0 0 0 1 -1.51 V 3 a 2 2 0 1 1 4 0 v .09 a 1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82 -.33 l .06 -.06 a 2 2 0 1 1 2.83 2.83 l -.06 .06 a 1.65 1.65 0 0 0 -.33 1.82 V 9 a 1.65 1.65 0 0 0 1.51 1 H 21 a 2 2 0 1 1 0 4 h -.09 a 1.65 1.65 0 0 0 -1.51 1 Z"
                                                      Width="14" Height="14" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        </Button>

                                        <!-- Fold Down Button -->
                                        <Button Command="{Binding CloseMobileSidebarCommand}"
                                                Classes="secondary" Width="30" Height="30" CornerRadius="15" Padding="0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                ToolTip.Tip="Fold down">
                                            <TextBlock Text="✕" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 3. Scrollable Sidebar Content (Settings / Photo info) -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="18,14,18,24">
                                <Panel>
                                    <!-- TAB 1: SETTINGS VIEW -->
                                    <StackPanel IsVisible="{Binding IsInspectorSettingsTab}" Spacing="14">
                                        <!-- Output Destination Section -->
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Output destination" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <!-- Browse Output Folder with Nested Reset Cross -->
                                            <Border Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                    BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1"
                                                    Height="36" CornerRadius="10" Padding="10,0,6,0" ClipToBounds="True"
                                                    HorizontalAlignment="Stretch">
                                                <Grid ColumnDefinitions="*,Auto" ClipToBounds="True">
                                                    <Button Grid.Column="0" Command="{Binding BrowseFolderCommand}"
                                                            Background="Transparent" BorderThickness="0" Padding="0"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                                            ClipToBounds="True"
                                                            ToolTip.Tip="Select custom output folder (Default: same as originals)">
                                                        <Button.Styles>
                                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </Style>
                                                            <Style Selector="Button:pointerover PathIcon">
                                                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                            </Style>
                                                        </Button.Styles>
                                                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                            <PathIcon Grid.Column="0" Data="M 3 7 V 5 h 7 l 2 3 h 9 v 12 H 3 Z" Width="13" Height="13"
                                                                      Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FormattedOutputFolderPath}" FontSize="10.5"
                                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button Grid.Column="1" Content="✕" Command="{Binding ClearOutputFolderCommand}"
                                                            IsVisible="{Binding HasCustomOutputFolder}"
                                                            Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                            Background="Transparent" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                            BorderThickness="0" Cursor="Hand" ToolTip.Tip="Reset to source folder">
                                                        <Button.Styles>
                                                            <Style Selector="Button:pointerover">
                                                                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </Style>
                                                        </Button.Styles>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <Separator Height="1" Background="{DynamicResource AppEdgeBrush}" Margin="0,4"/>

                                        <!-- File Handling Section -->
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="File handling" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                            <!-- Backup Switch -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Backup original file" FontSize="11"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CreateBackup}" OnContent="" OffContent=""/>
                                            </Grid>

                                            <!-- Suffix Switch -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Add filename suffix" FontSize="11"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AppendSuffix}" OnContent="" OffContent=""/>
                                            </Grid>

                                            <!-- Inline Suffix Input -->
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,-4,0,2" IsVisible="{Binding AppendSuffix}">
                                                <TextBlock Grid.Column="0" Text="Suffix:" VerticalAlignment="Center" FontSize="10" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                <TextBox Grid.Column="1" Text="{Binding Suffix}"
                                                         Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                         BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}"
                                                         Watermark="-fujified" FontSize="11" Height="28"
                                                         CornerRadius="8" VerticalContentAlignment="Center"/>
                                            </Grid>

                                            <!-- Subfolder Switch -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Save in subfolder" FontSize="11"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CreateSubfolder}" OnContent="" OffContent=""/>
                                            </Grid>

                                            <!-- Expandable Subfolder Settings -->
                                            <StackPanel Spacing="8" Margin="8,0,0,4" IsVisible="{Binding CreateSubfolder}">
                                                <!-- Keep original folder name switch -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Keep original folder name" FontSize="10"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding SubfolderUseOriginalName}" OnContent="" OffContent=""/>
                                                </Grid>

                                                <!-- Dir suffix (when using original name) -->
                                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding SubfolderUseOriginalName}">
                                                    <TextBlock Grid.Column="0" Text="Dir suffix:" VerticalAlignment="Center" FontSize="10" Margin="0,0,6,0"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SubfolderSuffix}"
                                                             Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                             BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}"
                                                             Watermark="_fujified" FontSize="10" Height="26"
                                                             CornerRadius="7" VerticalContentAlignment="Center"/>
                                                </Grid>

                                                <!-- Custom folder name (when NOT using original name) -->
                                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !SubfolderUseOriginalName}">
                                                    <TextBlock Grid.Column="0" Text="Folder name:" VerticalAlignment="Center" FontSize="10" Margin="0,0,6,0"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SubfolderCustomName}"
                                                             Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                             BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}"
                                                             Watermark="fujified" FontSize="10" Height="26"
                                                             CornerRadius="7" VerticalContentAlignment="Center"/>
                                                </Grid>

                                                <!-- Subfolder Preview -->
                                                <TextBlock Text="{Binding SubfolderPreview, StringFormat='Preview: {0}'}"
                                                           FontSize="9" Foreground="{DynamicResource AppAccentLightBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Open Folder When Done Switch -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Open folder when done" FontSize="11"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoOpenOutputFolder}" OnContent="" OffContent=""/>
                                            </Grid>

                                            <!-- Open in Lightroom Switch (Mobile & Supported Platforms) -->
                                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsOpenInLightroomSupported}">
                                                <TextBlock Grid.Column="0" Text="Open in Lightroom" FontSize="11"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoOpenInLightroom}" OnContent="" OffContent=""/>
                                            </Grid>
                                        </StackPanel>

                                        <Separator Height="1" Background="{DynamicResource AppEdgeBrush}" Margin="0,4"/>

                                        <!-- Available Simulations Section -->
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Available simulations" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <WrapPanel>
                                                <Border Classes="chip chosen" Margin="2">
                                                    <TextBlock Text="Classic Chrome" FontSize="9" FontWeight="SemiBold" Foreground="#E4D4FF"/>
                                                </Border>
                                                <Border Classes="chip" Margin="2">
                                                    <TextBlock Text="Classic Neg." FontSize="9" Foreground="#B2A9C6"/>
                                                </Border>
                                                <Border Classes="chip" Margin="2">
                                                    <TextBlock Text="Nostalgic Neg." FontSize="9" Foreground="#B2A9C6"/>
                                                </Border>
                                                <Border Classes="chip" Margin="2">
                                                    <TextBlock Text="Reala Ace" FontSize="9" Foreground="#B2A9C6"/>
                                                </Border>
                                                <Border Classes="chip" Margin="2">
                                                    <TextBlock Text="Velvia" FontSize="9" Foreground="#B2A9C6"/>
                                                </Border>
                                                <Border Classes="chip" Margin="2">
                                                    <TextBlock Text="Provia" FontSize="9" Foreground="#B2A9C6"/>
                                                </Border>
                                                <Border Classes="chip" Margin="2">
                                                    <TextBlock Text="Astia" FontSize="9" Foreground="#B2A9C6"/>
                                                </Border>
                                                <Border Classes="chip" Margin="2">
                                                    <TextBlock Text="Acros" FontSize="9" Foreground="#B2A9C6"/>
                                                </Border>
                                                <Border Classes="chip" Margin="2">
                                                    <TextBlock Text="Eterna" FontSize="9" Foreground="#B2A9C6"/>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- TAB 2: PHOTO INFO VIEW -->
                                    <StackPanel IsVisible="{Binding IsInspectorInfoTab}" Spacing="14">
                                        <!-- Empty Photo Selection State -->
                                        <TextBlock Text="Select a photo from the queue to view metadata and exposure details."
                                                   FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,20"
                                                   IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNull}}"/>

                                        <!-- Photo Info Details -->
                                        <StackPanel IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="12">
                                            <!-- Image Preview -->
                                            <Border MaxWidth="320" Height="175" CornerRadius="12" ClipToBounds="True"
                                                    Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                    BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8">
                                                <Image Source="{Binding SelectedFile.Thumbnail}" Stretch="Uniform"
                                                       MaxWidth="320" MaxHeight="175"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Photo Title & Camera Subhead -->
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding SelectedFile.FileName}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SelectedFile.CameraMakeAndModel}" FontSize="10"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Separator Height="1" Background="{DynamicResource AppEdgeBrush}"/>

                                            <!-- 2-Column Metadata Grid with EXIF and Date Taken -->
                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4">
                                                <!-- Aperture -->
                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                    <TextBlock Text="Aperture" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding SelectedFile.Aperture, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                </StackPanel>

                                                <!-- Shutter Speed -->
                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                                    <TextBlock Text="Shutter speed" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding SelectedFile.ShutterSpeed, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                </StackPanel>

                                                <!-- Focal Length -->
                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                                    <TextBlock Text="Focal length" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding SelectedFile.FocalLength, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                </StackPanel>

                                                <!-- File Size -->
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                                    <TextBlock Text="File size" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding SelectedFile.FormattedFileSize, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                </StackPanel>

                                                <!-- ISO -->
                                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                                    <TextBlock Text="ISO" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding SelectedFile.Iso, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                </StackPanel>

                                                <!-- Date Taken (EXIF) -->
                                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                                                    <TextBlock Text="Date taken" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding SelectedFile.DateTimeOriginal, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Status -->
                                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                                                    <TextBlock Text="Status" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding SelectedFile.Status, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppAccentLightBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Panel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>


                <!-- B. BATCH STUDIO LAYOUT: Left Rail + Main Studio Area (Heading, Queue, Inspector) on top, Full-width Footer on bottom -->
                <Grid IsVisible="{Binding !IsPhoneLayout}" RowDefinitions="*,Auto">

                    <!-- TOP SHELL: Left Rail + Main Workspace -->
                    <Grid Grid.Row="0" ColumnDefinitions="60,*">

                        <!-- 1. LEFT NAVIGATION RAIL -->
                        <Border Grid.Column="0" Background="Transparent"
                                BorderThickness="0"
                                Padding="6,16">
                            <Grid RowDefinitions="Auto,*,Auto,Auto">
                                <!-- Rail Logo (Fujifier Emblem) -->
                                <Border Grid.Row="0" Width="41" Height="41" CornerRadius="14"
                                        Background="#10C9FFDF" BorderBrush="#24B4FFDC" BorderThickness="1"
                                        HorizontalAlignment="Center" Margin="0,0,0,22" ToolTip.Tip="Fujifier">
                                    <Image Source="/Assets/images/logoXL.png" Width="26" Height="26" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Spacer -->
                                <Panel Grid.Row="1"/>

                                <!-- Settings Button -->
                                <Button Grid.Row="2" Classes="nav" Command="{Binding OpenPreferencesCommand}"
                                        HorizontalAlignment="Center" Margin="0,0,0,10" ToolTip.Tip="Settings">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <PathIcon Data="M 12 15 A 3 3 0 1 0 12 9 A 3 3 0 1 0 12 15 M 19.4 15 a 1.65 1.65 0 0 0 .33 1.82 l .06 .06 a 2 2 0 1 1 -2.83 2.83 l -.06 -.06 a 1.65 1.65 0 0 0 -1.82 -.33 1.65 1.65 0 0 0 -1 1.51 V 21 a 2 2 0 1 1 -4 0 v -.09 A 1.65 1.65 0 0 0 9 19.4 a 1.65 1.65 0 0 0 -1.82 .33 l -.06 .06 a 2 2 0 1 1 -2.83 -2.83 l .06 -.06 a 1.65 1.65 0 0 0 .33 -1.82 1.65 1.65 0 0 0 -1.51 -1 H 3 a 2 2 0 1 1 0 -4 h .09 A 1.65 1.65 0 0 0 4.6 9 a 1.65 1.65 0 0 0 -.33 -1.82 l -.06 -.06 a 2 2 0 1 1 2.83 -2.83 l .06 .06 a 1.65 1.65 0 0 0 1.82 .33 H 9 a 1.65 1.65 0 0 0 1 -1.51 V 3 a 2 2 0 1 1 4 0 v .09 a 1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82 -.33 l .06 -.06 a 2 2 0 1 1 2.83 2.83 l -.06 .06 a 1.65 1.65 0 0 0 -.33 1.82 V 9 a 1.65 1.65 0 0 0 1.51 1 H 21 a 2 2 0 1 1 0 4 h -.09 a 1.65 1.65 0 0 0 -1.51 1 Z" Width="18" Height="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Settings" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Info / About Button -->
                                <Button Grid.Row="3" Classes="nav" Command="{Binding OpenAboutCommand}"
                                        HorizontalAlignment="Center" Margin="0,0,0,6" ToolTip.Tip="About &amp; Info">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <PathIcon Data="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" Width="18" Height="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="About" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>


                        <!-- 2. MAIN WORKSPACE AREA -->
                        <Grid Grid.Column="1" RowDefinitions="Auto,*">

                            <!-- Top Heading & Step Workflow Indicators -->
                            <Border Grid.Row="0" Padding="8,18,24,10" Background="Transparent">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <!-- Studio Heading -->
                                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="FUJIFILM PICTURE PROFILES FOR EVERYONE" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="#9D96B6" LetterSpacing="1.8"/>
                                        <TextBlock Text="Fujifier" FontSize="26" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" LetterSpacing="-0.8"/>
                                        <TextBlock Text="Import your RAW photos. Unlock Fujifilm film simulation. Enjoy" FontSize="11"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>

                                    <!-- Step Workflow Indicators -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                        <!-- Step 1: Import -->
                                        <StackPanel Classes="step-item" Classes.current="{Binding IsStep1Current}"
                                                    Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Classes="step-badge" Width="19" Height="19" CornerRadius="10">
                                                <TextBlock Text="1" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Import" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Step 2: Configure -->
                                        <StackPanel Classes="step-item" Classes.current="{Binding IsStep2Current}"
                                                    Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Classes="step-badge" Width="19" Height="19" CornerRadius="10">
                                                <TextBlock Text="2" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Configure" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Step 3: Process -->
                                        <StackPanel Classes="step-item" Classes.current="{Binding IsStep3Current}"
                                                    Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Classes="step-badge" Width="19" Height="19" CornerRadius="10">
                                                <TextBlock Text="3" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Process" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Step 4: Done -->
                                        <StackPanel Classes="step-item" Classes.current="{Binding IsStep4Current}"
                                                    Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Classes="step-badge" Width="19" Height="19" CornerRadius="10">
                                                <TextBlock Text="4" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Done" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>


                        <!-- Central Workspace (Queue + Inspector) -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="8,4,24,18">

                            <!-- CENTER: Photo Queue Panel -->
                            <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,16,0">

                                <!-- Queue Top Section Header (Action buttons without "X photos in queue" sentence) -->
                                <Grid Grid.Row="0" Margin="0,0,0,14" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- Primary + Add Files -->
                                        <Button Classes="primary" Command="{Binding AddFilesCommand}"
                                                ToolTip.Tip="Import RAW photos from computer">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <PathIcon Data="M 11 4 A 1 1 0 0 1 13 4 V 11 H 20 A 1 1 0 0 1 20 13 H 13 V 20 A 1 1 0 0 1 11 20 V 13 H 4 A 1 1 0 0 1 4 11 H 11 Z" Width="12" Height="12" Foreground="{DynamicResource AppPrimaryBtnFgBrush}"/>
                                                <TextBlock Text="Add files" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppPrimaryBtnFgBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Secondary + Add Folder -->
                                        <Button Classes="secondary" Command="{Binding AddFolderCommand}"
                                                ToolTip.Tip="Import folder containing RAW photos">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <PathIcon Data="M 3 7 V 5 h 7 l 2 3 h 9 v 12 H 3 Z" Width="12" Height="12" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                <TextBlock Text="Add folder" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Secondary Clear -->
                                        <Button Classes="secondary" Command="{Binding ClearCommand}"
                                                IsVisible="{Binding HasFiles}" ToolTip.Tip="Remove all photos from queue">
                                            <TextBlock Text="Clear" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>


                                <!-- Queue Panel Card -->
                                <Border Grid.Row="1" Classes="panel" ClipToBounds="True">
                                    <Grid RowDefinitions="Auto,*">

                                        <!-- Panel Subhead: Title + Count Badge + View Mode Switcher -->
                                        <Border Grid.Row="0" Padding="20,16" Background="Transparent"
                                                BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                <!-- Queue Title & Badge -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <TextBlock Text="Photo queue" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Background="#10FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1"
                                                            CornerRadius="7" Padding="7,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Files.Count, StringFormat='{}{0} photos'}"
                                                                   FontSize="9" Foreground="{DynamicResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Segmented View Toggle (List vs Grid) with Icons -->
                                                <Border Grid.Column="1" Background="#101118" BorderBrush="#15FFFFFF" BorderThickness="1"
                                                        CornerRadius="10" Padding="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <Button Classes="view-toggle" Classes.active="{Binding IsListView}"
                                                                Command="{Binding SetListViewCommand}" ToolTip.Tip="List View">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <PathIcon Data="M 8 4.5 h 13 v 1.5 H 8 Z M 8 11.25 h 13 v 1.5 H 8 Z M 8 18 h 13 v 1.5 H 8 Z M 3 4.5 h 2.5 v 1.5 H 3 Z M 3 11.25 h 2.5 v 1.5 H 3 Z M 3 18 h 2.5 v 1.5 H 3 Z" Width="11" Height="11"/>
                                                                <TextBlock Text="List" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Classes="view-toggle" Classes.active="{Binding IsGridView}"
                                                                Command="{Binding SetGridViewCommand}" ToolTip.Tip="Grid View">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <PathIcon Data="M 3 3 h 7 v 7 H 3 Z M 14 3 h 7 v 7 H 14 Z M 3 14 h 7 v 7 H 3 Z M 14 14 h 7 v 7 H 14 Z" Width="11" Height="11"/>
                                                                <TextBlock Text="Grid" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Queue Content -->
                                        <Grid Grid.Row="1">
                                            <!-- Drag & Drop Overlay Feedback -->
                                            <Border IsVisible="{Binding IsDragOver}"
                                                    Background="{DynamicResource AppSurfaceBrush}"
                                                    Opacity="0.95"
                                                    BorderBrush="{DynamicResource AppAccentBrush}"
                                                    BorderThickness="2"
                                                    CornerRadius="20"
                                                    Margin="6"
                                                    ZIndex="99"
                                                    IsHitTestVisible="False">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                                    <Border Width="64" Height="64" CornerRadius="32"
                                                            Background="{DynamicResource AppGlassPillBrush}" HorizontalAlignment="Center">
                                                        <TextBlock Text="📥" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Drop RAW photos or folders here"
                                                               FontWeight="SemiBold" FontSize="16"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Release mouse to add files to queue"
                                                               FontSize="12" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Empty State Dropzone -->
                                            <Border IsVisible="{Binding !HasFiles}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="30">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                                    <Border Width="68" Height="68" CornerRadius="34"
                                                            Background="{DynamicResource AppSurfaceSecondaryBrush}" HorizontalAlignment="Center">
                                                        <TextBlock Text="📸" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Drag &amp; Drop RAW Photos Here"
                                                               FontWeight="SemiBold" FontSize="15"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Add more RAW files to include them in this batch."
                                                               FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Supported: RAF, ARW, CR2, CR3, NEF, DNG, RW2, ORF, PEF"
                                                               FontSize="10" Foreground="#747080" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 1. List View (DataGrid with Reduced-Glass Rows & Pills) -->
                                            <DataGrid x:Name="QueueDataGrid"
                                                      IsVisible="{Binding IsListView}" ItemsSource="{Binding Files}"
                                                      SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                                      AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto"
                                                      IsReadOnly="True" GridLinesVisibility="None" SelectionMode="Extended"
                                                      Background="Transparent" BorderThickness="0" Margin="14,8,14,8"
                                                      DoubleTapped="DataGrid_DoubleTapped">
                                                <DataGrid.KeyBindings>
                                                    <KeyBinding Gesture="Delete" Command="{Binding RemoveFileCommand}" CommandParameter="{Binding #QueueDataGrid.SelectedItems}"/>
                                                </DataGrid.KeyBindings>
                                                <DataGrid.Styles>
                                                    <Style Selector="DataGridRow" x:DataType="models:FileItem">
                                                        <Setter Property="ContextMenu">
                                                            <ContextMenu>
                                                                <MenuItem Header="Open Image"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenFileCommand}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <PathIcon Data="M 3 3 h 18 v 18 H 3 Z M 8 8 A 1.5 1.5 0 1 0 8 11 A 1.5 1.5 0 1 0 8 8 M 3 17 l 6 -6 l 4 4 l 3 -3 l 5 5" Width="13" Height="13" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Open With..."
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenWithCommand}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <PathIcon Data="M 18 13 v 6 a 2 2 0 0 1 -2 2 H 5 a 2 2 0 0 1 -2 -2 V 8 a 2 2 0 0 1 2 -2 h 6 M 15 3 h 6 v 6 M 10 14 L 21 3" Width="13" Height="13" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Open Containing Folder"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenFolderCommand}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <PathIcon Data="M 3 7 V 5 h 7 l 2 3 h 9 v 12 H 3 Z" Width="13" Height="13" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="Reset to Pending"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ResetStatusCommand}"
                                                                          CommandParameter="{Binding #QueueDataGrid.SelectedItems}">
                                                                    <MenuItem.Icon>
                                                                        <PathIcon Data="M 1 4 v 6 h 6 M 23 20 v -6 h -6 M 20.49 9 A 9 9 0 0 0 5.64 5.64 L 1 10 M 23 14 l -4.64 4.36 A 9 9 0 0 1 3.51 15" Width="13" Height="13" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="Properties"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowPropertiesCommand}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon>
                                                                        <PathIcon Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 M 12 16 v -4 M 12 8 h 0.01" Width="13" Height="13" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="Remove from Selection"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveFileCommand}"
                                                                          CommandParameter="{Binding #QueueDataGrid.SelectedItems}">
                                                                    <MenuItem.Icon>
                                                                        <PathIcon Data="M 18 6 L 6 18 M 6 6 l 12 12" Width="12" Height="12" Foreground="#FF8F8A"/>
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Setter>
                                                    </Style>
                                                </DataGrid.Styles>

                                                <DataGrid.Columns>
                                                    <!-- Thumbnail Column with Pill Accent Indicator on Selection -->
                                                    <DataGridTemplateColumn Width="66" CanUserResize="False">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:FileItem">
                                                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                    <!-- Purple accent indicator bar for selected row matching mockup -->
                                                                    <Border Grid.Column="0" Width="3" Height="26" CornerRadius="2"
                                                                            Background="#CDBBFF" Margin="0,0,8,0"
                                                                            IsVisible="{Binding $parent[DataGridRow].IsSelected}"/>
                                                                    <!-- Thumbnail -->
                                                                    <Border Grid.Column="1" Width="41" Height="39" CornerRadius="7" ClipToBounds="True"
                                                                            Background="{DynamicResource AppSurfaceSecondaryBrush}" VerticalAlignment="Center">
                                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- File Name + Size Subtitle Column -->
                                                    <DataGridTemplateColumn Header="File name" Width="*" MinWidth="160" SortMemberPath="FileName">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:FileItem">
                                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11"
                                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding FormattedFileSize, StringFormat='RAW image · {0}'}" FontSize="9"
                                                                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- Detected Camera Column (Matching Font Size) -->
                                                    <DataGridTemplateColumn Header="Detected camera" Width="150" MinWidth="100" SortMemberPath="CameraMakeAndModel">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:FileItem">
                                                                <TextBlock Text="{Binding CameraMakeAndModel}" FontSize="11"
                                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- Status Column (Center Aligned Single Icon) -->
                                                    <DataGridTemplateColumn Width="90" MinWidth="60" SortMemberPath="Status">
                                                        <DataGridTemplateColumn.Header>
                                                            <TextBlock Text="Status" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                        </DataGridTemplateColumn.Header>
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:FileItem">
                                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                                    <!-- Completed: Show single center-aligned status arrow -->
                                                                    <TextBlock IsVisible="{Binding IsCompleted}"
                                                                               Text="{Binding Status}"
                                                                               FontSize="13"
                                                                               HorizontalAlignment="Center"
                                                                               TextAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{Binding StatusColor}"/>
                                                                    <!-- Pending/In Progress/Error: Show StatusIcon + Status text, horizontally centered -->
                                                                    <StackPanel IsVisible="{Binding !IsCompleted}"
                                                                                Orientation="Horizontal"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                Spacing="4">
                                                                        <TextBlock Text="{Binding StatusIcon}" VerticalAlignment="Center" FontSize="11" Foreground="{Binding StatusColor}"/>
                                                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{Binding StatusColor}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- Remove Action Button Column (Small cross without rounded background) -->
                                                    <DataGridTemplateColumn Width="52" CanUserResize="False">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:FileItem">
                                                                <Button Content="✕"
                                                                        Command="{Binding RemoveCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="20" Height="20"
                                                                        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                        HorizontalAlignment="Right" Margin="0,0,14,0"
                                                                        Background="Transparent"
                                                                        Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                        BorderThickness="0"
                                                                        FontSize="11"
                                                                        Cursor="Hand"
                                                                        ToolTip.Tip="Remove from batch">
                                                                    <Button.Styles>
                                                                        <Style Selector="Button:pointerover">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                        </Style>
                                                                    </Button.Styles>
                                                                </Button>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- 2. Grid View (Thumbnail Cards) -->
                                            <ScrollViewer IsVisible="{Binding IsGridView}" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Files}" Margin="14">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:FileItem">
                                                            <Border Classes="grid-card" Classes.selected="{Binding IsSelected}"
                                                                    Width="150" Height="190" Margin="6" Padding="8"
                                                                    CornerRadius="14" Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                                    BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1"
                                                                    PointerPressed="GridItem_PointerPressed"
                                                                    DoubleTapped="GridItem_DoubleTapped"
                                                                    Cursor="Hand">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Open Image"
                                                                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenFileCommand}"
                                                                                  CommandParameter="{Binding}">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="M 3 3 h 18 v 18 H 3 Z M 8 8 A 1.5 1.5 0 1 0 8 11 A 1.5 1.5 0 1 0 8 8 M 3 17 l 6 -6 l 4 4 l 3 -3 l 5 5" Width="13" Height="13" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="Open With..."
                                                                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenWithCommand}"
                                                                                  CommandParameter="{Binding}">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="M 18 13 v 6 a 2 2 0 0 1 -2 2 H 5 a 2 2 0 0 1 -2 -2 V 8 a 2 2 0 0 1 2 -2 h 6 M 15 3 h 6 v 6 M 10 14 L 21 3" Width="13" Height="13" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="Open Containing Folder"
                                                                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenFolderCommand}"
                                                                                  CommandParameter="{Binding}">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="M 3 7 V 5 h 7 l 2 3 h 9 v 12 H 3 Z" Width="13" Height="13" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <Separator/>
                                                                        <MenuItem Header="Reset to Pending"
                                                                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ResetStatusCommand}"
                                                                                  CommandParameter="{Binding}">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="M 1 4 v 6 h 6 M 23 20 v -6 h -6 M 20.49 9 A 9 9 0 0 0 5.64 5.64 L 1 10 M 23 14 l -4.64 4.36 A 9 9 0 0 1 3.51 15" Width="13" Height="13" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <Separator/>
                                                                        <MenuItem Header="Properties"
                                                                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowPropertiesCommand}"
                                                                                  CommandParameter="{Binding}">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="M 12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 M 12 16 v -4 M 12 8 h 0.01" Width="13" Height="13" Foreground="{DynamicResource AppAccentBrush}"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <Separator/>
                                                                        <MenuItem Header="Remove from Selection"
                                                                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveFileCommand}"
                                                                                  CommandParameter="{Binding}">
                                                                            <MenuItem.Icon>
                                                                                <PathIcon Data="M 18 6 L 6 18 M 6 6 l 12 12" Width="12" Height="12" Foreground="#FF8F8A"/>
                                                                            </MenuItem.Icon>
                                                                        </MenuItem>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <Grid RowDefinitions="*,Auto,Auto">
                                                                    <!-- Thumbnail Button -->
                                                                    <Button Grid.Row="0"
                                                                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectFileCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            PointerPressed="GridItem_PointerPressed"
                                                                            DoubleTapped="GridItem_DoubleTapped"
                                                                            Background="Transparent" BorderThickness="0" Padding="0"
                                                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                        <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource AppSurfaceBrush}">
                                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                                                                                <Image.Transitions>
                                                                                    <Transitions>
                                                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                                                                                    </Transitions>
                                                                                </Image.Transitions>
                                                                            </Image>
                                                                        </Border>
                                                                    </Button>

                                                                    <!-- File Name -->
                                                                    <TextBlock Grid.Row="1" Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11"
                                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,6,0,2"
                                                                               TextTrimming="CharacterEllipsis"/>

                                                                    <!-- Status & Remove Button Row -->
                                                                    <Grid Grid.Row="2">
                                                                        <TextBlock Text="{Binding Status}" FontSize="11"
                                                                                   Foreground="{Binding StatusColor}" TextTrimming="CharacterEllipsis"
                                                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="24,0,24,0"/>
                                                                        <Button HorizontalAlignment="Right" Content="✕" Command="{Binding RemoveCommand}" CommandParameter="{Binding}"
                                                                                Width="20" Height="20" Padding="0"
                                                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                                Background="Transparent" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                                BorderThickness="0" FontSize="11" Cursor="Hand" ToolTip.Tip="Remove from batch">
                                                                            <Button.Styles>
                                                                                <Style Selector="Button:pointerover">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                                </Style>
                                                                            </Button.Styles>
                                                                        </Button>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>


                            <!-- RIGHT: Inspector Panel (Settings | Photo info Tabs) -->
                            <Border Grid.Column="1" Classes="panel" Width="295" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">

                                    <!-- Inspector Top Tabs -->
                                    <Border Grid.Row="0" Padding="16,14,16,0" Background="Transparent"
                                            BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,*">
                                            <!-- Settings Tab Button -->
                                            <Button Grid.Column="0" Command="{Binding SelectInspectorSettingsTabCommand}"
                                                    Classes="tab-btn" Classes.active="{Binding IsInspectorSettingsTab}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                    <TextBlock Text="Settings" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <Border Height="2" Width="48" Background="{DynamicResource AppAccentBrush}"
                                                            IsVisible="{Binding IsInspectorSettingsTab}"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Photo info Tab Button -->
                                            <Button Grid.Column="1" Command="{Binding SelectInspectorInfoTabCommand}"
                                                    Classes="tab-btn" Classes.active="{Binding IsInspectorInfoTab}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                    <TextBlock Text="Photo info" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                    <Border Height="2" Width="48" Background="{DynamicResource AppAccentBrush}"
                                                            IsVisible="{Binding IsInspectorInfoTab}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>


                                    <!-- Inspector Body Content -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18">
                                        <Panel>

                                            <!-- TAB 1: SETTINGS VIEW -->
                                            <StackPanel IsVisible="{Binding IsInspectorSettingsTab}" Spacing="14">
                                                <!-- Output Destination Section -->
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Output destination" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                                    <!-- Browse Output Folder with Nested Reset Cross -->
                                                    <Border Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                            BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1"
                                                            Height="36" CornerRadius="10" Padding="10,0,6,0" ClipToBounds="True"
                                                            HorizontalAlignment="Stretch" MaxWidth="259">
                                                        <Grid ColumnDefinitions="*,Auto" ClipToBounds="True">
                                                            <Button Grid.Column="0" Command="{Binding BrowseFolderCommand}"
                                                                    Background="Transparent" BorderThickness="0" Padding="0"
                                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                                                    ClipToBounds="True"
                                                                    ToolTip.Tip="Select custom output folder (Default: same as originals)">
                                                                <Button.Styles>
                                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                    </Style>
                                                                    <Style Selector="Button:pointerover PathIcon">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                                    </Style>
                                                                </Button.Styles>
                                                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                                    <PathIcon Grid.Column="0" Data="M 3 7 V 5 h 7 l 2 3 h 9 v 12 H 3 Z" Width="13" Height="13"
                                                                              Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedOutputFolderPath}" FontSize="10.5"
                                                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="1" Content="✕" Command="{Binding ClearOutputFolderCommand}"
                                                                    IsVisible="{Binding HasCustomOutputFolder}"
                                                                    Width="20" Height="20" Padding="0" Margin="4,0,0,0"
                                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                    Background="Transparent" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                    BorderThickness="0" Cursor="Hand" ToolTip.Tip="Reset to source folder">
                                                                <Button.Styles>
                                                                    <Style Selector="Button:pointerover">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                    </Style>
                                                                </Button.Styles>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>

                                                <Separator Height="1" Background="{DynamicResource AppEdgeBrush}" Margin="0,4"/>

                                                <!-- File Handling Section -->
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="File handling" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                                    <!-- Backup Switch -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Backup original file" FontSize="11"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CreateBackup}" OnContent="" OffContent=""/>
                                                    </Grid>

                                                    <!-- Suffix Switch -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Add filename suffix" FontSize="11"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AppendSuffix}" OnContent="" OffContent=""/>
                                                    </Grid>

                                                    <!-- Inline Suffix Input -->
                                                    <Grid ColumnDefinitions="Auto,*" Margin="0,-4,0,2" IsVisible="{Binding AppendSuffix}">
                                                        <TextBlock Grid.Column="0" Text="Suffix:" VerticalAlignment="Center" FontSize="10" Margin="0,0,6,0"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Suffix}"
                                                                 Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                 BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}"
                                                                 Watermark="-fujified" FontSize="11" Height="28"
                                                                 CornerRadius="8" VerticalContentAlignment="Center"/>
                                                    </Grid>

                                                    <!-- Subfolder Switch -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Save in subfolder" FontSize="11"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CreateSubfolder}" OnContent="" OffContent=""/>
                                                    </Grid>

                                                    <!-- Expandable Subfolder Settings -->
                                                    <StackPanel Spacing="8" Margin="8,0,0,4" IsVisible="{Binding CreateSubfolder}">
                                                        <!-- Keep original folder name switch -->
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="Keep original folder name" FontSize="10"
                                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SubfolderUseOriginalName}" OnContent="" OffContent=""/>
                                                        </Grid>

                                                        <!-- Dir suffix (when using original name) -->
                                                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding SubfolderUseOriginalName}">
                                                            <TextBlock Grid.Column="0" Text="Dir suffix:" VerticalAlignment="Center" FontSize="10" Margin="0,0,6,0"
                                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                            <TextBox Grid.Column="1" Text="{Binding SubfolderSuffix}"
                                                                     Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                     BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}"
                                                                     Watermark="_fujified" FontSize="10" Height="26"
                                                                     CornerRadius="7" VerticalContentAlignment="Center"/>
                                                        </Grid>

                                                        <!-- Custom folder name (when NOT using original name) -->
                                                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !SubfolderUseOriginalName}">
                                                            <TextBlock Grid.Column="0" Text="Folder name:" VerticalAlignment="Center" FontSize="10" Margin="0,0,6,0"
                                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                            <TextBox Grid.Column="1" Text="{Binding SubfolderCustomName}"
                                                                     Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                     BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}"
                                                                     Watermark="fujified" FontSize="10" Height="26"
                                                                     CornerRadius="7" VerticalContentAlignment="Center"/>
                                                        </Grid>

                                                        <!-- Subfolder Preview -->
                                                        <TextBlock Text="{Binding SubfolderPreview, StringFormat='Preview: {0}'}"
                                                                   FontSize="9" Foreground="{DynamicResource AppAccentLightBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <!-- Open Folder When Done Switch -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Open folder when done" FontSize="11"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoOpenOutputFolder}" OnContent="" OffContent=""/>
                                                    </Grid>

                                                    <!-- Open in Lightroom Switch (Mobile & Supported Platforms) -->
                                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsOpenInLightroomSupported}">
                                                        <TextBlock Grid.Column="0" Text="Open in Lightroom" FontSize="11"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoOpenInLightroom}" OnContent="" OffContent=""/>
                                                    </Grid>
                                                </StackPanel>

                                                <Separator Height="1" Background="{DynamicResource AppEdgeBrush}" Margin="0,4"/>

                                                <!-- Available Simulations Section -->
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Available simulations" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                                    <!-- Simulation Chips (Purple Aesthetic) -->
                                                    <WrapPanel>
                                                        <Border Classes="chip chosen" Margin="2">
                                                            <TextBlock Text="Classic Chrome" FontSize="9" FontWeight="SemiBold" Foreground="#E4D4FF"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Classic Neg." FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Nostalgic Neg." FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Reala Ace" FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Velvia" FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Provia" FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Astia" FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Acros" FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Eterna" FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>


                                            <!-- TAB 2: PHOTO INFO VIEW -->
                                            <StackPanel IsVisible="{Binding IsInspectorInfoTab}" Spacing="14">
                                                <!-- Empty Photo Selection State -->
                                                <TextBlock Text="Select a photo from the queue to view metadata and exposure details."
                                                           FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,20"
                                                           IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNull}}"/>

                                                <!-- Photo Info Details -->
                                                <StackPanel IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="12">
                                                    <!-- Image Preview (Full-width card with small margin, cleanly contained) -->
                                                    <Border MaxWidth="259" Height="175" CornerRadius="12" ClipToBounds="True"
                                                            Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                            BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8">
                                                        <Image Source="{Binding SelectedFile.Thumbnail}" Stretch="Uniform"
                                                               MaxWidth="259" MaxHeight="175"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Photo Title & Camera Subhead -->
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding SelectedFile.FileName}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SelectedFile.CameraMakeAndModel}" FontSize="10"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <Separator Height="1" Background="{DynamicResource AppEdgeBrush}"/>

                                                    <!-- 2-Column Metadata Grid with EXIF and Date Taken -->
                                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4">
                                                        <!-- Aperture -->
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                            <TextBlock Text="Aperture" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding SelectedFile.Aperture, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- Shutter Speed -->
                                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                                            <TextBlock Text="Shutter speed" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding SelectedFile.ShutterSpeed, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- Focal Length -->
                                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                                            <TextBlock Text="Focal length" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding SelectedFile.FocalLength, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- File Size -->
                                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                                            <TextBlock Text="File size" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding SelectedFile.FormattedFileSize, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- ISO -->
                                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                                            <TextBlock Text="ISO" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding SelectedFile.Iso, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- Date Taken (EXIF) -->
                                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                                                            <TextBlock Text="Date taken" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding SelectedFile.DateTimeOriginal, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <!-- Status -->
                                                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                                                            <TextBlock Text="Status" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding SelectedFile.Status, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppAccentLightBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Panel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- BOTTOM BAR: Studio Sticky Footer with Glowing Status & Process Button (Full width spanning across the entire window!) -->
                    <Border x:Name="DesktopBottomStatusBar" Grid.Row="1"
                            Background="{DynamicResource AppFooterBrush}"
                            BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,1,0,0"
                            Height="73" Padding="25,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <!-- Left: Glowing Status Indicator Dot & Details -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#A5D5B7" VerticalAlignment="Center"/>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OverallStatusText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding OutputDestinationSummary}" FontSize="9"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Center: Spacer / Centered Progress Line -->
                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                                         Value="{Binding ProgressValue}"
                                         IsVisible="{Binding IsProgressVisible}"
                                         Height="4" CornerRadius="2"
                                         Margin="40,0"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

                            <!-- Right: Protection Notice & Primary Process Action -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                                <TextBlock Text="Original files stay protected" FontSize="10"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>

                                <!-- Studio Process Batch Action Button with centered text and sparkle icon -->
                                <Button Command="{Binding ProcessCommand}"
                                        IsEnabled="{Binding CanProcessOrStop}" Classes="primary"
                                        Height="42" Padding="20,0" CornerRadius="21"
                                        VerticalAlignment="Center" ToolTip.Tip="Process batch with Fujifilm simulation profiles">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ProcessButtonContent}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppPrimaryBtnFgBrush}" VerticalAlignment="Center"/>
                                        <PathIcon Data="M 10 1 L 12.5 7.5 L 19 10 L 12.5 12.5 L 10 19 L 7.5 12.5 L 1 10 L 7.5 7.5 Z M 17 13 L 18.2 16.2 L 21.5 17.5 L 18.2 18.8 L 17 22 L 15.8 18.8 L 12.5 17.5 L 15.8 16.2 Z"
                                                  Width="13" Height="13"
                                                  Foreground="{DynamicResource AppPrimaryBtnFgBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>


        <!-- 3. FULL-SCREEN SLIDING PANEL: PREFERENCES / SETTINGS -->
        <Grid x:Name="PreferencesSlidePanel" ZIndex="10000"
              Background="{DynamicResource AppSolidBackgroundBrush}"
              RenderTransform="translateX(800px)"
              IsHitTestVisible="False">
            <Grid.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Grid.Transitions>

            <Grid x:Name="PreferencesRootGrid" RowDefinitions="Auto,*" DataContext="{Binding Preferences}">
                <!-- Navigation Top Bar -->
                <Border x:Name="PreferencesHeaderBar" Grid.Row="0"
                        Background="{DynamicResource AppSolidHeaderBrush}"
                        BorderThickness="0" Padding="16,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Command="{Binding CancelCommand}"
                                Background="Transparent" BorderThickness="0" Padding="6,8">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="‹" FontSize="24" FontWeight="Bold" Margin="0,-4,0,0" Foreground="{DynamicResource AppAccentBrush}"/>
                                <TextBlock Text="Back" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="1" Text="Settings" FontWeight="Bold" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>

                        <Button Grid.Column="2" Content="Save" Command="{Binding SaveCommand}"
                                Classes="primary" Height="36" Padding="16,0" CornerRadius="18"
                                FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Scrollable Settings Body -->
                <ScrollViewer x:Name="PreferencesScrollViewer" Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PreferencesContentStack" Spacing="16" MaxWidth="600" HorizontalAlignment="Stretch" Margin="16,12,16,24">

                        <!-- 1. THEME -->
                        <Border Classes="panel" ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Inner Group Header -->
                                <Border Grid.Row="0" Padding="18,12" Background="Transparent"
                                        BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                </Border>

                                <!-- Group Content -->
                                <StackPanel Grid.Row="1" Margin="18,14" Spacing="10">
                                    <TextBlock Text="Appearance Mode" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,4">
                                        <RadioButton Grid.Row="0" Grid.Column="0" Content="Automatic"
                                                     IsChecked="{Binding IsAutoThemeSelected, Mode=TwoWay}"
                                                     GroupName="MobileTheme" Margin="0,0,6,8"/>
                                        <RadioButton Grid.Row="0" Grid.Column="1" Content="Dark"
                                                     IsChecked="{Binding IsDarkThemeSelected, Mode=TwoWay}"
                                                     GroupName="MobileTheme" Margin="6,0,0,8"/>
                                        <RadioButton Grid.Row="1" Grid.Column="0" Content="AMOLED"
                                                     IsChecked="{Binding IsAmoledThemeSelected, Mode=TwoWay}"
                                                     GroupName="MobileTheme" Margin="0,0,6,0"/>
                                        <RadioButton Grid.Row="1" Grid.Column="1" Content="Light"
                                                     IsChecked="{Binding IsLightThemeSelected, Mode=TwoWay}"
                                                     GroupName="MobileTheme" Margin="6,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="Automatic adapts to system mode. Dark features refined slate tones. AMOLED provides true pitch-black contrast."
                                               FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. PERFORMANCE -->
                        <Border Classes="panel" ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Inner Group Header -->
                                <Border Grid.Row="0" Padding="18,12" Background="Transparent"
                                        BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Performance" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                </Border>

                                <!-- Group Content -->
                                <StackPanel Grid.Row="1" Margin="18,14" Spacing="12">
                                    <!-- Concurrency Slider -->
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Concurrent Conversions" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="4" Padding="5,1" IsVisible="{Binding !IsPro}" VerticalAlignment="Center">
                                                    <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="#252332"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding MaxConcurrentConversions}" FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource AppAccentLightBrush}"/>
                                        </Grid>
                                        <Slider Minimum="1" Maximum="{Binding TotalThreads}" Value="{Binding MaxConcurrentConversions}"
                                                IsEnabled="{Binding IsPro}"
                                                IsSnapToTickEnabled="True" TickFrequency="1"/>
                                        <TextBlock Text="{Binding ConcurrencyHint}" FontSize="11"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Separator Height="1" Background="{DynamicResource AppEdgeBrush}"/>

                                    <!-- Import Pictures Instantly Toggle -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                            <TextBlock Text="Import Pictures Instantly" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <TextBlock Text="Skips thumbnail generation for performance, importing photos into the queue instantly" FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SkipThumbnailGeneration}" OnContent="" OffContent=""/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 3. FILE HANDLING -->
                        <Border Classes="panel" ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Inner Group Header -->
                                <Border Grid.Row="0" Padding="18,12" Background="Transparent"
                                        BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="File Handling" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                </Border>

                                <!-- Group Content -->
                                <StackPanel Grid.Row="1" Margin="18,14" Spacing="12">
                                    <!-- Custom File Suffix -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                            <TextBlock Text="Add Suffix to Converted File Name" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <TextBlock Text="Appends custom text identifier before .dng extension" FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AppendSuffix}" OnContent="" OffContent=""/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0" IsVisible="{Binding AppendSuffix}">
                                        <TextBlock Grid.Column="0" Text="Suffix:" VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                        <TextBox Grid.Column="1" Text="{Binding Suffix}"
                                                 Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                 BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}"
                                                 Watermark="-fujified" FontSize="11" Height="32" CornerRadius="8" VerticalContentAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Example: DSC0001.ARW → DSC0001-fujified.dng" FontSize="11"
                                               Foreground="{DynamicResource AppAccentLightBrush}"
                                               IsVisible="{Binding AppendSuffix}" Margin="0,-4,0,2" TextWrapping="Wrap"/>

                                    <Separator Height="1" Background="{DynamicResource AppEdgeBrush}"/>

                                    <!-- Subfolder Option -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                            <TextBlock Text="Save Converted Photos in Subfolder" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <TextBlock Text="Creates a subfolder for converted DNGs instead of saving directly in source folder" FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CreateSubfolder}" OnContent="" OffContent=""/>
                                    </Grid>

                                    <StackPanel Spacing="8" Margin="0,4,0,2" IsVisible="{Binding CreateSubfolder}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                                <TextBlock Text="Keep Original Directory Name" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                <TextBlock Text="Uses the source directory name as base for the subfolder" FontSize="10.5"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SubfolderUseOriginalName}" OnContent="" OffContent=""/>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding SubfolderUseOriginalName}">
                                            <TextBlock Grid.Column="0" Text="Directory Suffix:" VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <TextBox Grid.Column="1" Text="{Binding SubfolderSuffix}"
                                                     Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                     BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}"
                                                     Watermark="-fujified" FontSize="11" Height="32" CornerRadius="8" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !SubfolderUseOriginalName}">
                                            <TextBlock Grid.Column="0" Text="Subfolder Name:" VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                            <TextBox Grid.Column="1" Text="{Binding SubfolderCustomName}"
                                                     Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                     BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}"
                                                     Watermark="Fujified" FontSize="11" Height="32" CornerRadius="8" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Text="{Binding SubfolderPreview, StringFormat='Example: {0}'}" FontSize="11"
                                                   Foreground="{DynamicResource AppAccentLightBrush}" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Separator Height="1" Background="{DynamicResource AppEdgeBrush}"/>

                                    <!-- Auto-Open Destination Folder -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                            <TextBlock Text="Open Destination Folder After Conversion" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <TextBlock Text="Automatically opens the destination folder in file manager when processing finishes" FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoOpenOutputFolder}" OnContent="" OffContent=""/>
                                    </Grid>

                                    <Separator Height="1" Background="{DynamicResource AppEdgeBrush}"/>

                                    <!-- Lossless Compression -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="Lossless DNG Compression" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="4" Padding="5,1" IsVisible="{Binding !IsPro}" VerticalAlignment="Center">
                                                    <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="#252332"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Reduces DNG file size with zero image quality loss (Pro only)" FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding LosslessCompression}" IsEnabled="{Binding IsPro}" OnContent="" OffContent=""/>
                                    </Grid>

                                    <Separator Height="1" Background="{DynamicResource AppEdgeBrush}"/>

                                    <!-- Backup Original File -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                            <TextBlock Text="Backup Original File" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <TextBlock Text="Preserves original file (renames in-place DNGs to filenameORIG.DNG). When disabled, files that succeed are sent to Trash." FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding BackupOriginalFile}" OnContent="" OffContent=""/>
                                    </Grid>

                                    <Separator Height="1" Background="{DynamicResource AppEdgeBrush}"/>

                                    <!-- Embed RAW -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                            <TextBlock Text="Embed Original RAW inside DNG" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <TextBlock Text="Preserves original unmodified camera sensor file inside DNG" FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EmbedOriginalRaw}" OnContent="" OffContent=""/>
                                    </Grid>

                                    <Separator Height="1" Background="{DynamicResource AppEdgeBrush}" IsVisible="{Binding IsOpenInLightroomSupported}"/>

                                    <!-- Auto-open in Lightroom -->
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsOpenInLightroomSupported}">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                            <TextBlock Text="Auto-Open Converted Photos in Lightroom" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <TextBlock Text="Automatically launches Lightroom with processed DNGs" FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoOpenInLightroom}" OnContent="" OffContent=""/>
                                    </Grid>

                                    <Separator Height="1" Background="{DynamicResource AppEdgeBrush}" IsVisible="{Binding IsWindows}"/>

                                    <!-- Windows Explorer Context Menu -->
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsWindows}">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Windows Context Menu (Fujifier)" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="4" Padding="5,1"
                                                        IsVisible="{Binding !IsPro}" VerticalAlignment="Center">
                                                    <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="#252332"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Adds 'Fujifier' cascading options to right-click menu on RAW files" FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsWindowsContextMenuEnabled}" OnContent="" OffContent=""/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 4. LICENSE & PLAN -->
                        <Border Classes="panel" ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Inner Group Header -->
                                <Border Grid.Row="0" Padding="18,12" Background="Transparent"
                                        BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="License &amp; Plan" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                </Border>

                                <!-- Group Content -->
                                <StackPanel Grid.Row="1" Margin="18,14" Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding LicenseStatusText}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="4" Padding="6,1" IsVisible="{Binding IsPro}" VerticalAlignment="Center">
                                                    <TextBlock Text="PRO ACTIVE" FontSize="9" FontWeight="Bold" Foreground="#252332"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LicenseDescriptionText}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="⭐ Get Pro" Command="{Binding UpgradeToProCommand}" Classes="primary" IsVisible="{Binding !IsPro}" Height="34" Padding="14,0" CornerRadius="17" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Deactivate" Command="{Binding DeactivateLicenseCommand}" Classes="secondary" IsVisible="{Binding IsPro}" Height="34" Padding="14,0" CornerRadius="17" VerticalContentAlignment="Center"/>
                                    </Grid>

                                    <!-- Connected Account Section (Visible when user is signed in) -->
                                    <Border Background="{DynamicResource AppSurfaceSecondaryBrush}" BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,2,0,0" IsVisible="{Binding IsAccountLoggedIn}">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="Fujifier Account" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentLightBrush}"/>
                                                <TextBlock Text="{Binding AccountDisplayText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="🔄 Retrieve" Command="{Binding RetrieveLicenseCommand}" IsEnabled="{Binding !IsRetrievingLicense}" Classes="secondary" Height="30" Padding="10,0" CornerRadius="15" VerticalContentAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                                            <Button Grid.Column="2" Content="Sign Out" Command="{Binding LogoutAccountCommand}" Classes="secondary" Height="30" Padding="10,0" CornerRadius="15" VerticalContentAlignment="Center" FontSize="11"/>
                                        </Grid>
                                    </Border>

                                    <!-- Activation Options when in Free Tier and not signed in -->
                                    <StackPanel Spacing="10" IsVisible="{Binding !IsAccountLoggedIn}">
                                        <Separator Height="1" Background="{DynamicResource AppEdgeBrush}"/>

                                        <!-- Tabs for Activation Mode: Account/Google vs Key -->
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <RadioButton Content="Sign In (Google / Account)" IsChecked="{Binding IsAccountTabActive, Mode=OneWay}" Command="{Binding SetAccountTabCommand}" GroupName="MobileActivationMode" FontSize="11.5"/>
                                            <RadioButton Content="Enter Key" IsChecked="{Binding IsKeyTabActive, Mode=OneWay}" Command="{Binding SetKeyTabCommand}" GroupName="MobileActivationMode" FontSize="11.5"/>
                                        </StackPanel>

                                        <!-- Option A: Google OAuth & Account Sign In -->
                                        <StackPanel Spacing="10" IsVisible="{Binding IsAccountTabActive}">
                                            <!-- Google Sign-In Button -->
                                            <Button Command="{Binding LoginWithGoogleCommand}" IsEnabled="{Binding !IsGoogleLoggingIn}"
                                                    Classes="secondary" Height="36" CornerRadius="18" Padding="14,0" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Fill="#4285F4" Data="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.66v3.04h3.87c2.26-2.09 3.67-5.17 3.67-9.14z"/>
                                                            <Path Fill="#34A853" Data="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.87-3.04c-1.08.72-2.45 1.16-4.06 1.16-3.13 0-5.78-2.11-6.73-4.96H1.25v3.13C3.25 21.31 7.35 24 12 24z"/>
                                                            <Path Fill="#FBBC05" Data="M5.27 14.25c-.25-.72-.38-1.49-.38-2.25s.13-1.53.38-2.25V6.62H1.25C.45 8.24 0 10.06 0 12s.45 3.76 1.25 5.38l4.02-3.13z"/>
                                                            <Path Fill="#EA4335" Data="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.35 0 3.25 2.69 1.25 6.62l4.02 3.13c.95-2.85 3.6-4.96 6.73-4.96z"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Text="Continue with Google" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Divider -->
                                            <Grid ColumnDefinitions="*,Auto,*" Margin="0,2">
                                                <Separator Grid.Column="0" Height="1" Background="{DynamicResource AppEdgeBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="or account login" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="8,0" VerticalAlignment="Center"/>
                                                <Separator Grid.Column="2" Height="1" Background="{DynamicResource AppEdgeBrush}" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Email and Password -->
                                            <TextBox Text="{Binding AccountEmailInput, Mode=TwoWay}" Watermark="Account Email" Height="32" CornerRadius="8" FontSize="11" BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}" Background="{DynamicResource AppSurfaceSecondaryBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalContentAlignment="Center"/>
                                            <TextBox Text="{Binding AccountPasswordInput, Mode=TwoWay}" PasswordChar="●" Watermark="Account Password" Height="32" CornerRadius="8" FontSize="11" BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}" Background="{DynamicResource AppSurfaceSecondaryBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalContentAlignment="Center"/>
                                            <Button Content="Sign In &amp; Sync License" Command="{Binding AccountLoginCommand}" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="34" CornerRadius="17" VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Option B: Direct License Key Input -->
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsKeyTabActive}">
                                            <TextBox Grid.Column="0" Text="{Binding LicenseKeyInput, Mode=TwoWay}" Watermark="Enter license key" Height="34" CornerRadius="8" FontSize="11" BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}" Background="{DynamicResource AppSurfaceSecondaryBrush}" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="Activate" Command="{Binding ActivateLicenseCommand}" Classes="primary" Height="34" Padding="16,0" CornerRadius="17" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Live Status Feedback Message -->
                                    <TextBlock Text="{Binding LicenseMessageText}" FontSize="11" Foreground="{Binding LicenseMessageColor}" IsVisible="{Binding HasLicenseMessage}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 5. UPDATES -->
                        <Border Classes="panel" ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <!-- Inner Group Header -->
                                <Border Grid.Row="0" Padding="18,12" Background="Transparent"
                                        BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Updates" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                </Border>

                                <!-- Group Content -->
                                <StackPanel Grid.Row="1" Margin="18,14" Spacing="12">
                                    <!-- Check on startup toggle -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                            <TextBlock Text="Check for Updates on Startup" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <TextBlock Text="Automatically check GitHub releases when Fujifier opens" FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckForUpdatesOnStartup}" OnContent="" OffContent=""/>
                                    </Grid>

                                    <Separator Height="1" Background="{DynamicResource AppEdgeBrush}"/>

                                    <!-- Manual Check Button -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding CurrentAppVersionText}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding UpdateStatusMessage}" FontSize="11"
                                                       Foreground="{Binding UpdateStatusColor}"
                                                       IsVisible="{Binding HasUpdateStatusMessage}" TextWrapping="Wrap"/>
                                            <TextBlock Text="Check GitHub releases for updates" FontSize="11"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       IsVisible="{Binding !HasUpdateStatusMessage}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Check Now" Command="{Binding CheckForUpdatesCommand}"
                                                IsEnabled="{Binding !IsCheckingForUpdate}"
                                                Classes="secondary" Height="34" Padding="16,0" CornerRadius="17"
                                                VerticalContentAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Bottom Action Buttons -->
                        <Grid ColumnDefinitions="*,*" Margin="0,8,0,16">
                            <Button Grid.Column="0" Content="Cancel" Command="{Binding CancelCommand}" Classes="secondary"
                                    Height="40" CornerRadius="20" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Save Settings" Command="{Binding SaveCommand}" Classes="primary"
                                    Height="40" CornerRadius="20" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Extra Bottom Clearance -->
                        <Border Height="24"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>


        <!-- 4. FULL-SCREEN SLIDING PANEL: ABOUT -->
        <Grid x:Name="AboutSlidePanel" ZIndex="10000"
              Background="{DynamicResource AppSolidBackgroundBrush}"
              RenderTransform="translateX(800px)"
              IsHitTestVisible="False">
            <Grid.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Grid.Transitions>

            <Grid x:Name="AboutRootGrid" RowDefinitions="Auto,*">
                <Border x:Name="AboutHeaderBar" Grid.Row="0"
                        Background="{DynamicResource AppSolidHeaderBrush}"
                        BorderThickness="0" Padding="16,12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Button Grid.Column="0" Command="{Binding CloseModalCommand}"
                                Background="Transparent" BorderThickness="0" Padding="6,8">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="‹" FontSize="24" FontWeight="Bold" Margin="0,-4,0,0" Foreground="{DynamicResource AppAccentBrush}"/>
                                <TextBlock Text="Back" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Text="About Fujifier" FontWeight="Bold" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-40,0,0,0"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="AboutScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="AboutContentStack" Spacing="16" MaxWidth="440" HorizontalAlignment="Center" Margin="20,20,20,24">
                        <!-- Header with Logo & Version -->
                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                            <Image Source="/Assets/images/logoXL.png" Width="52" Height="52" HorizontalAlignment="Center"/>
                            <TextBlock Text="Fujifier" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Version 2.1.0 (Cross-Platform)" FontSize="11" 
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Information Content Card -->
                        <Border Background="{DynamicResource AppSurfaceSecondaryBrush}" 
                                BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="14">
                            <StackPanel Spacing="9">
                                <TextBlock Text="Fujifilm Film Simulation Profiles for All Cameras" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="Converts camera RAW images to DNG while embedding Fujifilm camera profiles and metadata so Adobe Lightroom and Camera Raw (ACR) can apply authentic Fujifilm film simulations."
                                           FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                
                                <Separator Margin="0,2" Background="{DynamicResource AppEdgeBrush}"/>

                                <!-- Functional Link Buttons -->
                                <Grid ColumnDefinitions="*,*,*">
                                    <Button Grid.Column="0" Content="Website" Command="{Binding OpenWebsiteCommand}" Classes="secondary"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            FontSize="11" Height="30" Padding="0" CornerRadius="15" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="GitHub" Command="{Binding OpenGitHubCommand}" Classes="secondary"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            FontSize="11" Height="30" Padding="0" CornerRadius="15" Margin="2,0,2,0"/>
                                    <Button Grid.Column="2" Content="Updates" Command="{Binding OpenReleasesCommand}" Classes="secondary"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            FontSize="11" Height="30" Padding="0" CornerRadius="15" Margin="4,0,0,0"/>
                                </Grid>

                                <Separator Margin="0,2" Background="{DynamicResource AppEdgeBrush}"/>

                                <TextBlock Text="Developed by Isidore Paulin (ipweb.dev)" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="Powered by: DNGLab, ExifTool, Avalonia UI" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                <TextBlock Text="Licensed under GNU General Public License v3" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Close Button -->
                        <Button Content="Close" Command="{Binding CloseModalCommand}" Classes="primary" Height="34" Width="90" Padding="0" CornerRadius="17"
                                HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,6,0,0"/>
                        <Border Height="24"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>


        <!-- 5. IN-APP MODAL OVERLAY (Message / Conflict / Notification / FreeTierDelay) -->
        <Border ZIndex="9999"
                Background="#99070A12"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                IsHitTestVisible="{Binding IsBottomSheetOpen}"
                Classes="modal-backdrop" Classes.open="{Binding IsBottomSheetOpen}"
                PointerPressed="OnBackdropPointerPressed">
            <Border x:Name="ModalDialogContainer" Classes="panel modal-card" Classes.open="{Binding IsBottomSheetOpen}"
                    Width="400" MaxWidth="500" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Panel>
                    <!-- Free Tier Delay Modal -->
                    <StackPanel Spacing="12" IsVisible="{Binding IsFreeTierDelayModal}">
                        <!-- Header: Icon & Tier Badge -->
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" 
                                    Background="#1AB89BE4" 
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ModalIcon}" FontSize="20" 
                                           Foreground="{DynamicResource AppAccentLightBrush}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding ModalTitle}" FontWeight="SemiBold" FontSize="16" 
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Explanation & Details -->
                        <TextBlock Text="{Binding ModalMessage}" FontSize="11" TextWrapping="Wrap" 
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                   HorizontalAlignment="Center" TextAlignment="Center" LineHeight="16"/>

                        <!-- Cooldown Progress -->
                        <StackPanel Spacing="5" Margin="0,4,0,0">
                            <ProgressBar Height="4" CornerRadius="2" 
                                         Minimum="0" Maximum="15" Value="{Binding DelayProgressBarValue}" 
                                         Foreground="{DynamicResource AppAccentBrush}"/>
                            <TextBlock Text="{Binding DelayStatusText}" 
                                       FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- License Key Entry Section (Expandable) -->
                        <StackPanel IsVisible="{Binding IsDelayKeyInputVisible}" Spacing="6" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox Text="{Binding DelayLicenseKey, Mode=TwoWay}" Grid.Column="0" 
                                         Watermark="Paste FUJIFIER-PRO license key here..." 
                                         Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                                         BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}"
                                         FontSize="11" Height="34" CornerRadius="8" 
                                         VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Activate" Command="{Binding DelayActivateKeyCommand}" 
                                        Classes="primary" Height="34" Padding="16,0" CornerRadius="17"
                                        VerticalContentAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding DelayLicenseError}" FontSize="11" 
                                       Foreground="#E74C3C" IsVisible="{Binding HasDelayLicenseError}" 
                                       TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Middle Links (Buy Pro, Google Sign In & License Key) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,8">
                            <Button Content="⭐ Buy Pro" Command="{Binding BuyProCommand}" Classes="primary" 
                                    Height="34" Padding="14,0" CornerRadius="17"
                                    VerticalContentAlignment="Center" FontWeight="SemiBold" FontSize="11.5"/>
                            <Button Command="{Binding DelayGoogleSignInCommand}" Classes="secondary"
                                    Height="34" Padding="12,0" CornerRadius="17"
                                    VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#4285F4" Data="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.66v3.04h3.87c2.26-2.09 3.67-5.17 3.67-9.14z"/>
                                            <Path Fill="#34A853" Data="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.87-3.04c-1.08.72-2.45 1.16-4.06 1.16-3.13 0-5.78-2.11-6.73-4.96H1.25v3.13C3.25 21.31 7.35 24 12 24z"/>
                                            <Path Fill="#FBBC05" Data="M5.27 14.25c-.25-.72-.38-1.49-.38-2.25s.13-1.53.38-2.25V6.62H1.25C.45 8.24 0 10.06 0 12s.45 3.76 1.25 5.38l4.02-3.13z"/>
                                            <Path Fill="#EA4335" Data="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.35 0 3.25 2.69 1.25 6.62l4.02 3.13c.95-2.85 3.6-4.96 6.73-4.96z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Login" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Content="License Key" Command="{Binding DelayToggleKeyCommand}" Classes="secondary"
                                    Height="34" Padding="12,0" CornerRadius="17"
                                    VerticalContentAlignment="Center" FontSize="11.5"/>
                        </StackPanel>

                        <!-- Bottom Action: Continue with Free Version (Disabled until timer finishes) -->
                        <Button Content="{Binding DelayDismissButtonText}" 
                                Command="{Binding CloseModalCommand}"
                                IsEnabled="{Binding CanDismissModal}" 
                                Classes="secondary"
                                Height="36" CornerRadius="18" HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Standard Message Modal -->
                    <StackPanel Spacing="14" IsVisible="{Binding IsMessageModal}">
                        <!-- Status Icon -->
                        <Border Width="48" Height="48" CornerRadius="24" Background="{Binding ModalBadgeBackground}" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ModalIcon}" FontSize="24" Foreground="{Binding ModalIconColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Title & Message -->
                        <TextBlock Text="{Binding ModalTitle}" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="{Binding ModalMessage}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <!-- Centered Dismiss Button -->
                        <Button Content="Got it" Command="{Binding CloseModalCommand}" Classes="primary"
                                Height="38" CornerRadius="19" Padding="24,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Panel>
            </Border>
        </Border>
    </Grid>
</UserControl>
