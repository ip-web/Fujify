<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fujify.ViewModels;assembly=Fujifier"
             xmlns:models="clr-namespace:Fujify.Models;assembly=Fujifier"
             x:Class="Fujify.Views.MainView"
             x:DataType="vm:MainViewModel"
             TopLevel.AutoSafeAreaPadding="False"
             DragDrop.AllowDrop="True">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Delete" Command="{Binding RemoveFileCommand}" CommandParameter="{Binding SelectedFile}"/>
        <KeyBinding Gesture="Back" Command="{Binding RemoveFileCommand}" CommandParameter="{Binding SelectedFile}"/>
    </UserControl.KeyBindings>

    <Grid Background="{DynamicResource AppBackgroundBrush}" ClipToBounds="True">
        <!-- AMBIENT PURPLE & TEAL GLOW ACCENTS (Matching HTML Mockup) -->
        <Canvas IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Top-Right Purple Ambient Glow -->
            <Ellipse Width="650" Height="420" Canvas.Right="-120" Canvas.Top="-150" Opacity="0.14">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#C2ACEB" Offset="0"/>
                        <GradientStop Color="#7351B5" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Bottom-Left Subtle Teal Ambient Glow -->
            <Ellipse Width="550" Height="360" Canvas.Left="-100" Canvas.Bottom="-100" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#276E69" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- BASE APP INTERFACE -->
        <Grid RowDefinitions="Auto,*">

            <!-- 1. TOP TITLEBAR (Custom Reduced-Glass Studio Titlebar) -->
            <Border x:Name="HeaderBar" Grid.Row="0"
                    Background="{DynamicResource AppHeaderBrush}"
                    BorderThickness="0"
                    Height="35"
                    Padding="21,0">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <!-- Left: Studio Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="⋈" FontSize="13" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Fujifier — Film simulation engine" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Studio Dots & Action Shortcut -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Pro Active Pill if applicable -->
                        <Border Background="#1AC2ACEB" BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="STUDIO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppAccentLightBrush}"/>
                        </Border>
                        <!-- Subtle Window Dots -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#15FFFFFF" Stroke="#26FFFFFF" StrokeThickness="1"/>
                            <Ellipse Width="7" Height="7" Fill="#15FFFFFF" Stroke="#26FFFFFF" StrokeThickness="1"/>
                            <Ellipse Width="7" Height="7" Fill="#15FFFFFF" Stroke="#26FFFFFF" StrokeThickness="1"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MAIN BODY (PHONE LAYOUT vs DESKTOP BATCH STUDIO LAYOUT) -->
            <Grid Grid.Row="1">

                <!-- A. PHONE LAYOUT (Touch-First Cards, Single Column) -->
                <Grid IsVisible="{Binding IsPhoneLayout}" RowDefinitions="Auto,*,Auto">
                    <!-- Quick Toolbar with Studio Buttons -->
                    <Border Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="16,8">
                        <Grid ColumnDefinitions="*,*,*">
                            <Button Grid.Column="0" Content="+ Add Files" Command="{Binding AddFilesCommand}"
                                    Classes="primary" Margin="0,0,4,0" Height="40" Padding="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    FontSize="12" FontWeight="SemiBold" CornerRadius="20"/>
                            <Button Grid.Column="1" Content="+ Add Folder" Command="{Binding AddFolderCommand}"
                                    Classes="secondary" Margin="2,0,2,0" Height="40" Padding="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    FontSize="12" FontWeight="SemiBold" CornerRadius="20"/>
                            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearCommand}"
                                    IsEnabled="{Binding CanClear}"
                                    Classes="secondary" Margin="4,0,0,0" Height="40" Padding="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    FontSize="12" FontWeight="SemiBold" CornerRadius="20"/>
                        </Grid>
                    </Border>

                    <!-- Phone File List / Empty State -->
                    <Grid Grid.Row="1">
                        <!-- Empty State -->
                        <ScrollViewer IsVisible="{Binding !HasFiles}" HorizontalScrollBarVisibility="Disabled">
                            <Border Padding="16,8" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="10" HorizontalAlignment="Stretch" MaxWidth="340">
                                    <Border Width="64" Height="64" CornerRadius="32"
                                            Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="📸" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Add RAW Photos to Begin" FontWeight="Bold" FontSize="17"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tap '+ Add Files' above to import RAW files from your camera, SD card, or photo library."
                                               FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- Mobile Card List -->
                        <ScrollViewer IsVisible="{Binding HasFiles}" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Files}" Margin="16,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileItem">
                                        <Border Margin="0,5" Padding="12" CornerRadius="16"
                                                Background="{DynamicResource AppSurfaceBrush}"
                                                BorderBrush="{DynamicResource AppEdgeBrush}"
                                                BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!-- Thumbnail -->
                                                <Border Grid.Column="0" Width="64" Height="64" CornerRadius="10"
                                                        ClipToBounds="True" Background="{DynamicResource AppSurfaceSecondaryBrush}" VerticalAlignment="Center">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                </Border>

                                                <!-- File Info -->
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CameraMakeAndModel}" FontSize="12"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Border HorizontalAlignment="Left" CornerRadius="6" Padding="8,3"
                                                            Background="{DynamicResource AppSurfaceSecondaryBrush}">
                                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusColor}"
                                                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Remove Action -->
                                                <Button Grid.Column="2" Content="✕"
                                                        Command="{Binding RemoveCommand}"
                                                        CommandParameter="{Binding}"
                                                        Width="32" Height="32" CornerRadius="16"
                                                        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AppGlassPillBrush}"
                                                        Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                        BorderThickness="0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Phone Bottom Action Bar -->
                    <Border x:Name="PhoneBottomBar" Grid.Row="2" Background="{DynamicResource AppFooterBrush}"
                            BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#A5D5B7" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding OverallStatusText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="{Binding OutputDestinationSummary}" FontSize="9"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding ProcessButtonContent}" Command="{Binding ProcessCommand}"
                                    IsEnabled="{Binding CanProcessOrStop}" Classes="primary"
                                    Height="40" Padding="16,0" FontSize="12" FontWeight="SemiBold" CornerRadius="20"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>


                <!-- B. BATCH STUDIO LAYOUT: Left Rail + Main Studio Area (Heading, Queue, Inspector, Footer) -->
                <Grid IsVisible="{Binding !IsPhoneLayout}" ColumnDefinitions="88,*">

                    <!-- 1. LEFT NAVIGATION RAIL -->
                    <Border Grid.Column="0" Background="Transparent"
                            BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,0,1,0"
                            Padding="11,16">
                        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                            <!-- Rail Logo (Emblem) -->
                            <Button Grid.Row="0" Command="{Binding NavHomeCommand}"
                                    Width="42" Height="42" CornerRadius="14" Padding="0"
                                    Background="#10C9FFDF" BorderBrush="#24B4FFDC" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="0,0,0,22" ToolTip.Tip="Fujifier Batch Studio">
                                <TextBlock Text="⋈" FontSize="24" Foreground="#C6F1DB"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Navigation Buttons -->
                            <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center">
                                <!-- Home Nav -->
                                <Button Classes="nav" Command="{Binding NavHomeCommand}"
                                        Classes.active="{Binding ActiveNavTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='home'}"
                                        ToolTip.Tip="Studio Overview">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <PathIcon Data="M 3 10 L 12 3 L 21 10 V 20 H 3 Z M 9 20 V 13 H 15 V 20" Width="18" Height="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Home" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Photos / Queue Nav (Active by default) -->
                                <Button Classes="nav" Command="{Binding NavPhotosCommand}"
                                        Classes.active="{Binding ActiveNavTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='photos'}"
                                        ToolTip.Tip="Photo Batch Queue">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <PathIcon Data="M 3 3 H 21 V 21 H 3 Z M 8 8 A 1.5 1.5 0 1 0 8 5 A 1.5 1.5 0 1 0 8 8 M 3 17 L 9 11 L 13 15 L 16 12 L 21 17" Width="18" Height="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Photos" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Presets Nav -->
                                <Button Classes="nav" Command="{Binding NavPresetsCommand}"
                                        Classes.active="{Binding ActiveNavTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter='presets'}"
                                        ToolTip.Tip="Film Simulation Profiles">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <PathIcon Data="M 12 3 L 21 8 L 12 13 L 3 8 Z M 3 12 L 12 17 L 21 12 M 3 16 L 12 21 L 21 16" Width="18" Height="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Presets" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Spacer -->
                            <Border Grid.Row="2"/>

                            <!-- Settings Button -->
                            <Button Grid.Row="3" Classes="nav" Command="{Binding OpenPreferencesCommand}"
                                    HorizontalAlignment="Center" Margin="0,0,0,10" ToolTip.Tip="Settings &amp; License">
                                <StackPanel Spacing="5" HorizontalAlignment="Center">
                                    <PathIcon Data="M 4 7 h 16 M 4 17 h 16 M 7 7 A 2 2 0 1 0 11 7 A 2 2 0 1 0 7 7 M 13 17 A 2 2 0 1 0 17 17 A 2 2 0 1 0 13 17" Width="18" Height="18" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Settings" FontSize="9" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Avatar Circle (Account / Pro Status) -->
                            <Button Grid.Row="4" Command="{Binding OpenPreferencesCommand}"
                                    Width="30" Height="30" CornerRadius="15" Padding="0"
                                    BorderBrush="#33FFFFFF" BorderThickness="1" HorizontalAlignment="Center"
                                    ToolTip.Tip="Account / Plan Status">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#BDD4BC" Offset="0"/>
                                        <GradientStop Color="#9B8DD0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock Text="{Binding AvatarInitials}" FontSize="9" FontWeight="Bold"
                                           Foreground="#253B36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>


                    <!-- 2. MAIN WORKSPACE AREA -->
                    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

                        <!-- Top Heading & Step Workflow Indicators -->
                        <Border Grid.Row="0" Padding="25,20,25,12" Background="Transparent">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <!-- Studio Heading -->
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="A LITTLE CHARACTER. EVERY FILE." FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="#9D96B6" LetterSpacing="1.8"/>
                                    <TextBlock Text="Batch studio" FontSize="26" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" LetterSpacing="-0.8"/>
                                    <TextBlock Text="Import your photos. Configure your output. Make it yours." FontSize="11"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>

                                <!-- Step Workflow Indicators -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <!-- Step 1: Import -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="19" Height="19" CornerRadius="10"
                                                Background="{DynamicResource AppGlassPillBrush}" BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1">
                                            <TextBlock Text="1" FontSize="9" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Import" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Step 2: Configure (Current / Active Accent) -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="19" Height="19" CornerRadius="10"
                                                Background="#22B89BE4" BorderBrush="#33D4B9FF" BorderThickness="1">
                                            <TextBlock Text="2" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentLightBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Configure" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentLightBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Step 3: Export -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="19" Height="19" CornerRadius="10"
                                                Background="{DynamicResource AppGlassPillBrush}" BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1">
                                            <TextBlock Text="3" FontSize="9" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Export" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>


                        <!-- Central Workspace (Queue + Inspector) -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="25,4,25,18">

                            <!-- CENTER: Photo Queue Panel -->
                            <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,16,0">

                                <!-- Queue Top Section Header -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14" VerticalAlignment="Center">
                                    <!-- Count Info -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Files.Count, StringFormat='{}{0} photos in your batch'}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <!-- Primary + Add Files -->
                                        <Button Classes="primary" Command="{Binding AddFilesCommand}"
                                                ToolTip.Tip="Import RAW photos from computer">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <PathIcon Data="M 12 5 v 14 M 5 12 h 14" Width="13" Height="13" Foreground="{DynamicResource AppPrimaryBtnFgBrush}"/>
                                                <TextBlock Text="Add files" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppPrimaryBtnFgBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Secondary + Add Folder -->
                                        <Button Classes="secondary" Command="{Binding AddFolderCommand}"
                                                ToolTip.Tip="Import folder containing RAW photos">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <PathIcon Data="M 3 7 V 5 h 7 l 2 3 h 9 v 12 H 3 Z" Width="13" Height="13" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                <TextBlock Text="Add folder" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Secondary Clear -->
                                        <Button Classes="secondary" Command="{Binding ClearCommand}"
                                                IsVisible="{Binding HasFiles}" ToolTip.Tip="Remove all photos from queue">
                                            <TextBlock Text="Clear" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>


                                <!-- Queue Panel Card -->
                                <Border Grid.Row="1" Classes="panel" ClipToBounds="True">
                                    <Grid RowDefinitions="Auto,*">

                                        <!-- Panel Subhead: Title + Count Badge + View Mode Switcher -->
                                        <Border Grid.Row="0" Padding="20,16" Background="Transparent"
                                                BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                <!-- Queue Title & Badge -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <TextBlock Text="Photo queue" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border Background="#10FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1"
                                                            CornerRadius="7" Padding="7,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Files.Count, StringFormat='{}{0} photos'}"
                                                                   FontSize="9" Foreground="{DynamicResource AppTextSecondaryBrush}" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Segmented View Toggle (List vs Grid) -->
                                                <Border Grid.Column="1" Background="#101118" BorderBrush="#15FFFFFF" BorderThickness="1"
                                                        CornerRadius="10" Padding="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                        <Button Classes="view-toggle" Classes.active="{Binding IsListView}"
                                                                Command="{Binding SetListViewCommand}" ToolTip.Tip="List View">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <PathIcon Data="M 8 5 h 13 M 8 12 h 13 M 8 19 h 13 M 3 5 h 1 M 3 12 h 1 M 3 19 h 1" Width="11" Height="11"/>
                                                                <TextBlock Text="List" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Classes="view-toggle" Classes.active="{Binding IsGridView}"
                                                                Command="{Binding SetGridViewCommand}" ToolTip.Tip="Grid View">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <PathIcon Data="M 3 3 h 7 v 7 H 3 Z M 14 3 h 7 v 7 H 14 Z M 3 14 h 7 v 7 H 3 Z M 14 14 h 7 v 7 H 14 Z" Width="11" Height="11"/>
                                                                <TextBlock Text="Grid" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Queue Content -->
                                        <Grid Grid.Row="1">
                                            <!-- Drag & Drop Overlay Feedback -->
                                            <Border IsVisible="{Binding IsDragOver}"
                                                    Background="{DynamicResource AppSurfaceBrush}"
                                                    Opacity="0.95"
                                                    BorderBrush="{DynamicResource AppAccentBrush}"
                                                    BorderThickness="2"
                                                    CornerRadius="20"
                                                    Margin="6"
                                                    ZIndex="99"
                                                    IsHitTestVisible="False">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                                    <Border Width="64" Height="64" CornerRadius="32"
                                                            Background="{DynamicResource AppGlassPillBrush}" HorizontalAlignment="Center">
                                                        <TextBlock Text="📥" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Drop RAW photos or folders here"
                                                               FontWeight="SemiBold" FontSize="16"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Release mouse to add files to queue"
                                                               FontSize="12" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Empty State Dropzone -->
                                            <Border IsVisible="{Binding !HasFiles}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="30">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                                    <Border Width="68" Height="68" CornerRadius="34"
                                                            Background="{DynamicResource AppSurfaceSecondaryBrush}" HorizontalAlignment="Center">
                                                        <TextBlock Text="📸" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Drag &amp; Drop RAW Photos Here"
                                                               FontWeight="SemiBold" FontSize="15"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Add more RAW files to include them in this batch."
                                                               FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Supported: RAF, ARW, CR2, CR3, NEF, DNG, RW2, ORF, PEF"
                                                               FontSize="10" Foreground="#747080" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 1. List View (DataGrid with Reduced-Glass Rows) -->
                                            <DataGrid x:Name="QueueDataGrid"
                                                      IsVisible="{Binding IsListView}" ItemsSource="{Binding Files}"
                                                      SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                                      AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto"
                                                      IsReadOnly="True" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                                                      Background="Transparent" BorderThickness="0" Margin="14,8,14,8"
                                                      DoubleTapped="DataGrid_DoubleTapped">
                                                <DataGrid.KeyBindings>
                                                    <KeyBinding Gesture="Delete" Command="{Binding RemoveFileCommand}" CommandParameter="{Binding #QueueDataGrid.SelectedItems}"/>
                                                    <KeyBinding Gesture="Back" Command="{Binding RemoveFileCommand}" CommandParameter="{Binding #QueueDataGrid.SelectedItems}"/>
                                                </DataGrid.KeyBindings>
                                                <DataGrid.Styles>
                                                    <Style Selector="DataGridRow" x:DataType="models:FileItem">
                                                        <Setter Property="Background" Value="{Binding ErrorBackground}"/>
                                                        <Setter Property="ContextMenu">
                                                            <ContextMenu>
                                                                <MenuItem Header="Open Image"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenFileCommand}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon><TextBlock Text="🖼" FontSize="13"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Open With..."
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenWithCommand}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon><TextBlock Text="↗" FontSize="13"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Open Containing Folder"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenFolderCommand}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon><TextBlock Text="📁" FontSize="13"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="Reset to Pending"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ResetStatusCommand}"
                                                                          CommandParameter="{Binding #QueueDataGrid.SelectedItems}">
                                                                    <MenuItem.Icon><TextBlock Text="↺" FontSize="13"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="Properties"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ShowPropertiesCommand}"
                                                                          CommandParameter="{Binding}">
                                                                    <MenuItem.Icon><TextBlock Text="ℹ" FontSize="13"/></MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator/>
                                                                <MenuItem Header="Remove from Selection"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RemoveFileCommand}"
                                                                          CommandParameter="{Binding #QueueDataGrid.SelectedItems}">
                                                                    <MenuItem.Icon><TextBlock Text="✕" FontSize="13" Foreground="#E74C3C"/></MenuItem.Icon>
                                                                </MenuItem>
                                                            </ContextMenu>
                                                        </Setter>
                                                    </Style>
                                                </DataGrid.Styles>

                                                <DataGrid.Columns>
                                                    <!-- Thumbnail Column -->
                                                    <DataGridTemplateColumn Width="56" CanUserResize="False">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:FileItem">
                                                                <Border Width="41" Height="39" CornerRadius="7" ClipToBounds="True"
                                                                        Background="{DynamicResource AppSurfaceSecondaryBrush}" VerticalAlignment="Center">
                                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- File Name + Size Subtitle Column -->
                                                    <DataGridTemplateColumn Header="File name" Width="*" MinWidth="160" SortMemberPath="FileName">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:FileItem">
                                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11"
                                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding FormattedFileSize, StringFormat='RAW image · {0}'}" FontSize="9"
                                                                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- Detected Camera Column -->
                                                    <DataGridTextColumn Header="Detected camera" Binding="{Binding CameraMakeAndModel}" Width="150" MinWidth="100"/>

                                                    <!-- Status Column (Center Aligned Single Icon) -->
                                                    <DataGridTemplateColumn Width="90" MinWidth="60" SortMemberPath="Status">
                                                        <DataGridTemplateColumn.Header>
                                                            <TextBlock Text="Status" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                        </DataGridTemplateColumn.Header>
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:FileItem">
                                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                                    <!-- Completed: Show single center-aligned status arrow -->
                                                                    <TextBlock IsVisible="{Binding IsCompleted}"
                                                                               Text="{Binding Status}"
                                                                               FontSize="13"
                                                                               HorizontalAlignment="Center"
                                                                               TextAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{Binding StatusColor}"/>
                                                                    <!-- Pending/In Progress/Error: Show StatusIcon + Status text, horizontally centered -->
                                                                    <StackPanel IsVisible="{Binding !IsCompleted}"
                                                                                Orientation="Horizontal"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                Spacing="4">
                                                                        <TextBlock Text="{Binding StatusIcon}" VerticalAlignment="Center" FontSize="11" Foreground="{Binding StatusColor}"/>
                                                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{Binding StatusColor}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <!-- Remove Action Button Column -->
                                                    <DataGridTemplateColumn Width="46" CanUserResize="False">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate x:DataType="models:FileItem">
                                                                <Button Content="✕"
                                                                        Command="{Binding RemoveCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="24" Height="24" CornerRadius="12"
                                                                        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                        Background="{DynamicResource AppGlassPillBrush}"
                                                                        Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                        BorderThickness="0"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- 2. Grid View (Thumbnail Cards) -->
                                            <ScrollViewer IsVisible="{Binding IsGridView}" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Files}" Margin="14">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:FileItem">
                                                            <Border Width="150" Height="190" Margin="6" Padding="8"
                                                                    CornerRadius="14" Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                                    BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1">
                                                                <Grid RowDefinitions="*,Auto,Auto">
                                                                    <!-- Thumbnail Button -->
                                                                    <Button Grid.Row="0"
                                                                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectFileCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            DoubleTapped="GridItem_DoubleTapped"
                                                                            Background="Transparent" BorderThickness="0" Padding="0"
                                                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                                        <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource AppSurfaceBrush}">
                                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                                        </Border>
                                                                    </Button>

                                                                    <!-- File Name -->
                                                                    <TextBlock Grid.Row="1" Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11"
                                                                               Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,6,0,2"
                                                                               TextTrimming="CharacterEllipsis"/>

                                                                    <!-- Status & Remove Button Row -->
                                                                    <Grid Grid.Row="2">
                                                                        <TextBlock Text="{Binding Status}" FontSize="11"
                                                                                   Foreground="{Binding StatusColor}" TextTrimming="CharacterEllipsis"
                                                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="24,0,24,0"/>
                                                                        <Button HorizontalAlignment="Right" Content="✕" Command="{Binding RemoveCommand}" CommandParameter="{Binding}"
                                                                                Width="22" Height="22" CornerRadius="11" Padding="0"
                                                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                                Background="{DynamicResource AppGlassPillBrush}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                                BorderThickness="0"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>


                            <!-- RIGHT: Inspector Panel (Settings | Photo info Tabs) -->
                            <Border Grid.Column="1" Classes="panel" Width="295" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">

                                    <!-- Inspector Top Tabs -->
                                    <Border Grid.Row="0" Padding="16,14,16,0" Background="Transparent"
                                            BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,*">
                                            <!-- Settings Tab Button -->
                                            <Button Grid.Column="0" Command="{Binding SelectInspectorSettingsTabCommand}"
                                                    Background="Transparent" BorderThickness="0" Padding="0,0,0,12"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                    <TextBlock Text="Settings" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding IsInspectorSettingsTab, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=True, Converter={x:Null}}"
                                                               HorizontalAlignment="Center"/>
                                                    <Border Height="2" Width="40" Background="{DynamicResource AppAccentBrush}"
                                                            IsVisible="{Binding IsInspectorSettingsTab}"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Photo info Tab Button -->
                                            <Button Grid.Column="1" Command="{Binding SelectInspectorInfoTabCommand}"
                                                    Background="Transparent" BorderThickness="0" Padding="0,0,0,12"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                    <TextBlock Text="Photo info" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <Border Height="2" Width="40" Background="{DynamicResource AppAccentBrush}"
                                                            IsVisible="{Binding IsInspectorInfoTab}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>


                                    <!-- Inspector Body Content -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18">
                                        <Panel>

                                            <!-- TAB 1: SETTINGS VIEW -->
                                            <StackPanel IsVisible="{Binding IsInspectorSettingsTab}" Spacing="14">
                                                <!-- Output Destination Section -->
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Output destination" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                                    <!-- Browse Output Folder Button -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Button Grid.Column="0" Command="{Binding BrowseFolderCommand}"
                                                                Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                                BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1"
                                                                Height="36" CornerRadius="10" Padding="10,0"
                                                                HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                                                                ToolTip.Tip="Select custom output folder (Default: same as originals)">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <TextBlock Grid.Column="0" Text="📁 " FontSize="11" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding FormattedOutputFolderPath}" FontSize="10"
                                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>

                                                        <Button Grid.Column="1" Content="✕" Command="{Binding ClearOutputFolderCommand}"
                                                                IsVisible="{Binding HasCustomOutputFolder}"
                                                                Width="28" Height="28" CornerRadius="14" Margin="4,0,0,0" Padding="0"
                                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                                Background="{DynamicResource AppGlassPillBrush}" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                                BorderThickness="0" ToolTip.Tip="Reset to source folder"/>
                                                    </Grid>
                                                </StackPanel>

                                                <Separator Height="1" Background="{DynamicResource AppEdgeBrush}" Margin="0,4"/>

                                                <!-- File Handling Section -->
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="File handling" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                                    <!-- Backup Switch -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Back up original DNG" FontSize="11"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CreateBackup}" OnContent="" OffContent=""/>
                                                    </Grid>

                                                    <!-- Suffix Switch -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Add filename suffix" FontSize="11"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AppendSuffix}" OnContent="" OffContent=""/>
                                                    </Grid>

                                                    <!-- Inline Suffix Input -->
                                                    <Grid ColumnDefinitions="Auto,*" Margin="0,-4,0,2" IsVisible="{Binding AppendSuffix}">
                                                        <TextBlock Grid.Column="0" Text="Suffix:" VerticalAlignment="Center" FontSize="10" Margin="0,0,6,0"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Suffix}"
                                                                 Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                                 Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                 BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}"
                                                                 Watermark="-fujified" FontSize="11" Height="28"
                                                                 CornerRadius="8" VerticalContentAlignment="Center"/>
                                                    </Grid>

                                                    <!-- Subfolder Switch -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Save in subfolder" FontSize="11"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CreateSubfolder}" OnContent="" OffContent=""/>
                                                    </Grid>

                                                    <!-- Inline Subfolder Settings -->
                                                    <StackPanel Spacing="6" Margin="0,-4,0,2" IsVisible="{Binding CreateSubfolder}">
                                                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !SubfolderUseOriginalName}">
                                                            <TextBlock Grid.Column="0" Text="Folder:" VerticalAlignment="Center" FontSize="10" Margin="0,0,6,0"
                                                                       Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                            <TextBox Grid.Column="1" Text="{Binding SubfolderCustomName}"
                                                                     Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                                     BorderThickness="1" BorderBrush="{DynamicResource AppEdgeBrush}"
                                                                     Watermark="fujified" FontSize="11" Height="28"
                                                                     CornerRadius="8" VerticalContentAlignment="Center"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Open Folder When Done Switch -->
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="Open folder when done" FontSize="11"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoOpenOutputFolder}" OnContent="" OffContent=""/>
                                                    </Grid>

                                                    <!-- Open in Lightroom Switch (Mobile & Supported Platforms) -->
                                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsOpenInLightroomSupported}">
                                                        <TextBlock Grid.Column="0" Text="Open in Lightroom" FontSize="11"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoOpenInLightroom}" OnContent="" OffContent=""/>
                                                    </Grid>
                                                </StackPanel>

                                                <Separator Height="1" Background="{DynamicResource AppEdgeBrush}" Margin="0,4"/>

                                                <!-- Available Simulations Section -->
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Available simulations" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                                                    <!-- Simulation Chips (Purple Aesthetic) -->
                                                    <WrapPanel>
                                                        <Border Classes="chip chosen" Margin="2">
                                                            <TextBlock Text="Classic Chrome" FontSize="9" FontWeight="SemiBold" Foreground="#E4D4FF"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Classic Neg." FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Nostalgic Neg." FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Reala Ace" FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Velvia" FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Provia" FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Astia" FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Acros" FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                        <Border Classes="chip" Margin="2">
                                                            <TextBlock Text="Eterna" FontSize="9" Foreground="#B2A9C6"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- Selected Photo Mini Card Preview -->
                                                <Border Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                        BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1"
                                                        CornerRadius="12" Padding="10" Margin="0,10,0,0"
                                                        IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                                                                ClipToBounds="True" Background="{DynamicResource AppSurfaceBrush}" Margin="0,0,10,0">
                                                            <Image Source="{Binding SelectedFile.Thumbnail}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{Binding SelectedFile.FileName}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SelectedFile.FormattedFileSize, StringFormat='Selected photo · {0}'}" FontSize="8.5"
                                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>


                                            <!-- TAB 2: PHOTO INFO VIEW -->
                                            <StackPanel IsVisible="{Binding IsInspectorInfoTab}" Spacing="14">
                                                <!-- Empty Photo Selection State -->
                                                <TextBlock Text="Select a photo from the queue to view metadata and exposure details."
                                                           FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,20"
                                                           IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNull}}"/>

                                                <!-- Photo Info Details -->
                                                <StackPanel IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="12">
                                                    <!-- Large Image Preview -->
                                                    <Border Height="170" CornerRadius="13" ClipToBounds="True"
                                                            Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                                            BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1">
                                                        <Image Source="{Binding SelectedFile.Thumbnail}" Stretch="UniformToFill"/>
                                                    </Border>

                                                    <!-- Photo Title & Camera Subhead -->
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding SelectedFile.FileName}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SelectedFile.CameraMakeAndModel}" FontSize="10"
                                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <Separator Height="1" Background="{DynamicResource AppEdgeBrush}"/>

                                                    <!-- 2-Column Metadata Grid -->
                                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                                                        <!-- Aperture -->
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                            <TextBlock Text="Aperture" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding SelectedFile.Aperture, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- Shutter Speed -->
                                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                                            <TextBlock Text="Shutter speed" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding SelectedFile.ShutterSpeed, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- Focal Length -->
                                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                                            <TextBlock Text="Focal length" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding SelectedFile.FocalLength, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- File Size -->
                                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                                                            <TextBlock Text="File size" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding SelectedFile.FormattedFileSize, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- ISO -->
                                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                                            <TextBlock Text="ISO" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding SelectedFile.Iso, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- Status -->
                                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                                            <TextBlock Text="Status" FontSize="8.5" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,3"/>
                                                            <TextBlock Text="{Binding SelectedFile.Status, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AppAccentLightBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Panel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>


                        <!-- BOTTOM BAR: Studio Sticky Footer with Glowing Status & Process Button -->
                        <Border x:Name="DesktopBottomStatusBar" Grid.Row="2"
                                Background="{DynamicResource AppFooterBrush}"
                                BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="0,1,0,0"
                                Height="73" Padding="25,0">
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <!-- Left: Glowing Status Indicator Dot & Details -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#A5D5B7" VerticalAlignment="Center"/>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OverallStatusText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding OutputDestinationSummary}" FontSize="9"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Center: Spacer / Centered Progress Line -->
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressValue}"
                                             IsVisible="{Binding IsProgressVisible}"
                                             Height="4" CornerRadius="2"
                                             Margin="40,0"
                                             HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

                                <!-- Right: Protection Notice & Primary Process Action -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                                    <TextBlock Text="Original files stay protected" FontSize="10"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>

                                    <!-- Studio Process Batch Action Button -->
                                    <Button Content="{Binding ProcessButtonContent}" Command="{Binding ProcessCommand}"
                                            IsEnabled="{Binding CanProcessOrStop}" Classes="primary"
                                            Height="42" Padding="20,0" FontSize="12" FontWeight="SemiBold" CornerRadius="21"
                                            VerticalAlignment="Center" ToolTip.Tip="Process batch with Fujifilm simulation profiles"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>


        <!-- 3. FULL-SCREEN SLIDING PANEL: PREFERENCES / SETTINGS -->
        <Grid x:Name="PreferencesSlidePanel" ZIndex="10000"
              Background="{DynamicResource AppSolidBackgroundBrush}"
              RenderTransform="translateX(800px)"
              Opacity="0"
              IsHitTestVisible="False">
            <Grid.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Grid.Transitions>

            <Grid RowDefinitions="Auto,*">
                <!-- Navigation Top Bar -->
                <Border x:Name="PreferencesHeaderBar" Grid.Row="0"
                        Background="{DynamicResource AppSolidHeaderBrush}"
                        BorderThickness="0" Padding="16,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Command="{Binding Preferences.CancelCommand}"
                                Background="Transparent" BorderThickness="0" Padding="6,8">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="‹" FontSize="24" FontWeight="Bold" Margin="0,-4,0,0" Foreground="{DynamicResource AppAccentBrush}"/>
                                <TextBlock Text="Back" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="1" Text="Settings" FontWeight="Bold" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>

                        <Button Grid.Column="2" Content="Save" Command="{Binding Preferences.SaveCommand}"
                                Classes="primary" Height="36" Padding="16,0" CornerRadius="18"
                                FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Scrollable Settings Body -->
                <ScrollViewer Grid.Row="1" Padding="16,12">
                    <StackPanel Spacing="20" MaxWidth="540" HorizontalAlignment="Stretch">
                        <TextBlock Text="Preferences" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource AppTextPrimaryBrush}"/>

                        <!-- Theme Selection -->
                        <Border Classes="panel" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Theme Mode" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                    <ComboBox Grid.Column="1" SelectedItem="{Binding Preferences.ThemeMode, Mode=TwoWay}"
                                              ItemsSource="{Binding Preferences.AvailableThemes}" Width="140"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Account & Plan Info -->
                        <Border Classes="panel" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Account &amp; License" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Preferences.LicenseStatusText}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Preferences.LicenseDescriptionText}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>


        <!-- 4. FULL-SCREEN SLIDING PANEL: ABOUT -->
        <Grid x:Name="AboutSlidePanel" ZIndex="10000"
              Background="{DynamicResource AppSolidBackgroundBrush}"
              RenderTransform="translateX(800px)"
              Opacity="0"
              IsHitTestVisible="False">
            <Grid.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Grid.Transitions>

            <Grid RowDefinitions="Auto,*">
                <Border x:Name="AboutHeaderBar" Grid.Row="0"
                        Background="{DynamicResource AppSolidHeaderBrush}"
                        BorderThickness="0" Padding="16,12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Button Grid.Column="0" Command="{Binding CloseModalCommand}"
                                Background="Transparent" BorderThickness="0" Padding="6,8">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="‹" FontSize="24" FontWeight="Bold" Margin="0,-4,0,0" Foreground="{DynamicResource AppAccentBrush}"/>
                                <TextBlock Text="Back" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AppAccentBrush}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Text="About Fujifier" FontWeight="Bold" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-40,0,0,0"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="20">
                    <StackPanel Spacing="16" MaxWidth="440" HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="16" Background="#10C9FFDF" BorderBrush="#24B4FFDC" BorderThickness="1"
                                HorizontalAlignment="Center">
                            <TextBlock Text="⋈" FontSize="36" Foreground="#C6F1DB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Fujifier Batch Studio" FontWeight="Bold" FontSize="18"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Film Simulation Engine" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Developed by Isidore Paulin (ipweb.dev). Licensed under GPL v3."
                                   FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>


        <!-- 5. IN-APP MODAL OVERLAY (Message / Conflict / Notification) -->
        <Border IsVisible="{Binding IsBottomSheetOpen}" ZIndex="9999"
                Background="#99070A12"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                PointerPressed="OnBackdropPointerPressed">
            <Border x:Name="ModalDialogContainer" Classes="panel"
                    Width="400" MaxWidth="500" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <!-- Status Icon -->
                    <Border Width="48" Height="48" CornerRadius="24" Background="#1AB89BE4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ModalIcon}" FontSize="24" Foreground="{DynamicResource AppAccentLightBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Title & Message -->
                    <TextBlock Text="{Binding ModalTitle}" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="{Binding ModalMessage}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <!-- Centered Dismiss Button -->
                    <Button Content="Got it" Command="{Binding CloseModalCommand}" Classes="primary"
                            Height="38" CornerRadius="19" Padding="24,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
