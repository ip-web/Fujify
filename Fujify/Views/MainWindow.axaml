<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fujify.ViewModels"
        xmlns:models="using:Fujify.Models"
        x:Class="Fujify.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Fujify"
        Width="750" Height="700"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/images/logo.ico"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                BorderBrush="{DynamicResource SystemControlHighlightBaseLowBrush}" BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- App Title and Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="/Assets/images/logos.png" Width="28" Height="28"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Fujify" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="Fujifilm Film Simulations for All Cameras" FontSize="11" 
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Header Actions (About, Preferences) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="⚙ Preferences" Command="{Binding OpenPreferencesCommand}" 
                            FontSize="12" Padding="10,6"/>
                    <Button Content="ℹ About" Command="{Binding OpenAboutCommand}" 
                            FontSize="12" Padding="10,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                BorderBrush="{DynamicResource SystemControlHighlightBaseLowBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0" Content="+ Add Files" Command="{Binding AddFilesCommand}" 
                        Classes="accent" Margin="0,0,8,0" Padding="12,6"/>
                <Button Grid.Column="1" Content="+ Add Folder" Command="{Binding AddFolderCommand}" 
                        Margin="0,0,12,0" Padding="12,6"/>

                <!-- Output Folder Selection -->
                <Button Grid.Column="2" Command="{Binding BrowseFolderCommand}" 
                        HorizontalAlignment="Stretch" Margin="0,0,12,0" Padding="10,6"
                        ToolTip.Tip="Click to select a destination folder for converted files">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="📁 Output: " FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding FormattedOutputFolderPath}" FontSize="12" 
                                   TextTrimming="CharacterEllipsis" 
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </Grid>
                </Button>

                <!-- Clear Button -->
                <Button Grid.Column="4" Content="Clear" Command="{Binding ClearCommand}" 
                        IsEnabled="{Binding CanClear}" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- Empty State / Drop Target -->
            <Border IsVisible="{Binding !HasFiles}" Background="Transparent" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <Border Width="80" Height="80" CornerRadius="40" 
                            Background="{DynamicResource SystemControlHighlightBaseLowBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="📥" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Drag &amp; Drop RAW Photos or Folders Here" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Supported: RAF, ARW, CR2, CR3, NEF, DNG, RW2, ORF, PEF, and more" 
                               FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- File List (DataGrid) -->
            <DataGrid IsVisible="{Binding HasFiles}" ItemsSource="{Binding Files}" 
                      AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True"
                      IsReadOnly="True" GridLinesVisibility="Horizontal" SelectionMode="Extended">
                <DataGrid.Columns>
                    <!-- Thumbnail -->
                    <DataGridTemplateColumn Header="Preview" Width="76">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:FileItem">
                                <Border Margin="4" CornerRadius="4" ClipToBounds="True" Background="#1A000000">
                                    <Image Source="{Binding Thumbnail}" Width="60" Height="60" Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- File Name -->
                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*" />

                    <!-- Camera Make & Model -->
                    <DataGridTextColumn Header="Detected Camera" Binding="{Binding CameraMakeAndModel}" Width="160" />

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Status" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:FileItem">
                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="6,0" 
                                           FontWeight="SemiBold" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Loading Overlay -->
            <Border IsVisible="{Binding IsLoading}" Background="#66000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <ProgressBar IsIndeterminate="True" Width="200"/>
                    <TextBlock Text="Importing photos..." Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer / Process Bar -->
        <Border Grid.Row="3" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                BorderBrush="{DynamicResource SystemControlHighlightBaseLowBrush}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Backup Checkbox -->
                <CheckBox Grid.Column="0" Content="Backup Original DNG files" 
                          IsChecked="{Binding CreateBackup}" VerticalAlignment="Center"/>

                <!-- Progress Bar -->
                <Grid Grid.Column="1" Margin="20,0" VerticalAlignment="Center" IsVisible="{Binding IsProgressVisible}">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="10"/>
                </Grid>

                <!-- Process / Stop Button -->
                <Button Grid.Column="2" Content="{Binding ProcessButtonContent}" Command="{Binding ProcessCommand}" 
                        IsEnabled="{Binding CanProcessOrStop}" Classes="accent"
                        FontSize="14" FontWeight="Bold" Padding="24,8" MinWidth="110" HorizontalContentAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
