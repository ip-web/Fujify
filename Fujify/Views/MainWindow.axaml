<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fujify.ViewModels"
        xmlns:views="using:Fujify.Views"
        x:Class="Fujify.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Fujifier - Fujifilm Film Simulation Engine"
        Width="1180" Height="800"
        MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="35"
        TransparencyLevelHint="Mica, AcrylicBlur"
        Background="Transparent"
        Icon="/Assets/images/logo.ico">

    <views:MainView />
</Window>
