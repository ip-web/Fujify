<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fujify.ViewModels"
        x:Class="Fujify.Views.QuickProcessWindow"
        x:DataType="vm:QuickProcessViewModel"
        Title="{Binding Title}"
        Width="460" Height="260"
        MinWidth="420" MinHeight="240"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="Mica, AcrylicBlur"
        Background="Transparent"
        Icon="/Assets/images/logo.ico">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid Margin="24" RowDefinitions="Auto, *, Auto">
            <!-- Header: Status Icon & Titles -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,16">
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" 
                        Background="{DynamicResource AppGlassPillBrush}" 
                        VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="{Binding StatusIcon}" FontSize="20" 
                               Foreground="{Binding StatusIconColor}" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" 
                               Foreground="{DynamicResource AppTextPrimaryBrush}" 
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" 
                               Foreground="{DynamicResource AppTextSecondaryBrush}" 
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Progress Section -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10" Margin="0,10,0,10">
                <ProgressBar Height="8" CornerRadius="4" Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ProgressDetailText}" 
                               FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" 
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercentageText}" 
                               FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                </Grid>
            </StackPanel>

            <!-- Action Buttons Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Open Output Folder" Command="{Binding OpenFolderCommand}" 
                        IsVisible="{Binding CanOpenFolder}" Height="36" Padding="14,0" CornerRadius="10"
                        VerticalContentAlignment="Center"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" 
                        IsVisible="{Binding IsProcessing}" Height="36" Width="90" CornerRadius="10"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="Done" Command="{Binding DoneCommand}" 
                        IsVisible="{Binding IsCompleted}" Classes="accent" Height="36" Width="90" CornerRadius="10"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
