<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fujify.ViewModels"
        x:Class="Fujify.Views.PreferencesWindow"
        x:DataType="vm:PreferencesViewModel"
        Title="Preferences"
        Width="520" Height="650"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="Mica, AcrylicBlur"
        Background="Transparent"
        Icon="/Assets/images/logo.ico">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid Margin="24" RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Preferences" FontWeight="Bold" FontSize="18"
                       Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,16"/>

            <!-- Settings Options Grouped by Category -->
            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="18">

                    <!-- 1. THEME -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="THEME" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" LetterSpacing="1" Margin="2,0"/>
                        <Border Background="{DynamicResource AppSurfaceBrush}" 
                                CornerRadius="14" Padding="16" BorderThickness="0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Appearance Mode" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                <Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,2">
                                    <RadioButton Grid.Column="0" Content="Automatic" IsChecked="{Binding IsAutoThemeSelected, Mode=TwoWay}" GroupName="DesktopTheme"/>
                                    <RadioButton Grid.Column="1" Content="Dark" IsChecked="{Binding IsDarkThemeSelected, Mode=TwoWay}" GroupName="DesktopTheme"/>
                                    <RadioButton Grid.Column="2" Content="AMOLED" IsChecked="{Binding IsAmoledThemeSelected, Mode=TwoWay}" GroupName="DesktopTheme"/>
                                    <RadioButton Grid.Column="3" Content="Light" IsChecked="{Binding IsLightThemeSelected, Mode=TwoWay}" GroupName="DesktopTheme"/>
                                </Grid>
                                <TextBlock Text="Automatic adapts to system dark/light mode. Dark features refined slate tones. AMOLED provides true pitch-black contrast."
                                           FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 2. PERFORMANCE -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="PERFORMANCE" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" LetterSpacing="1" Margin="2,0"/>
                        <Border Background="{DynamicResource AppSurfaceBrush}" 
                                CornerRadius="14" Padding="16" BorderThickness="0">
                            <StackPanel Spacing="12">
                                <!-- Concurrency Slider -->
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Concurrent Conversions" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MaxConcurrentConversions}" FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource AppAccentBrush}"/>
                                    </Grid>
                                    <Slider Minimum="1" Maximum="{Binding TotalThreads}" Value="{Binding MaxConcurrentConversions}" 
                                            IsSnapToTickEnabled="True" TickFrequency="1"/>
                                    <TextBlock Text="{Binding ConcurrencyHint}" FontSize="11" 
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                </StackPanel>

                                <Separator Height="1" Background="{DynamicResource AppSurfaceSecondaryBrush}"/>

                                <!-- Skip Thumbnails Toggle -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Skip Thumbnail Generation" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Speeds up batch photo queue loading significantly" FontSize="11"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding SkipThumbnailGeneration}" OnContent="" OffContent=""/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. FILE HANDLING -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="FILE HANDLING" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" LetterSpacing="1" Margin="2,0"/>
                        <Border Background="{DynamicResource AppSurfaceBrush}" 
                                CornerRadius="14" Padding="16" BorderThickness="0">
                            <StackPanel Spacing="12">
                                <!-- Custom File Suffix -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Add Suffix to Converted File Name" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Appends custom text identifier before .dng extension" FontSize="11"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AppendSuffix}" OnContent="" OffContent=""/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0" IsVisible="{Binding AppendSuffix}">
                                    <TextBlock Grid.Column="0" Text="Suffix:" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Suffix}"
                                             Background="{DynamicResource AppSurfaceSecondaryBrush}"
                                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                                             BorderThickness="0" Watermark="-fujified" FontSize="12" Height="32" CornerRadius="8" VerticalContentAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Example: DSC0001.ARW → DSC0001-fujified.dng" FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           IsVisible="{Binding AppendSuffix}" Margin="0,-4,0,2"/>

                                <Separator Height="1" Background="{DynamicResource AppSurfaceSecondaryBrush}"/>

                                <!-- Lossless Compression -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Lossless DNG Compression" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Reduces DNG file size with zero image quality loss" FontSize="11"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding LosslessCompression}" OnContent="" OffContent=""/>
                                </Grid>

                                <Separator Height="1" Background="{DynamicResource AppSurfaceSecondaryBrush}"/>

                                <!-- Embed RAW -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Embed Original RAW inside DNG" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Preserves original unmodified camera sensor file inside DNG" FontSize="11"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EmbedOriginalRaw}" OnContent="" OffContent=""/>
                                </Grid>

                                <Separator Height="1" Background="{DynamicResource AppSurfaceSecondaryBrush}"/>

                                <!-- Auto-open in Lightroom -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Auto-Open Converted Photos in Lightroom" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Automatically launches Lightroom with processed DNGs" FontSize="11"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoOpenInLightroom}" OnContent="" OffContent=""/>
                                </Grid>

                                <Separator Height="1" Background="{DynamicResource AppSurfaceSecondaryBrush}" IsVisible="{Binding IsWindows}"/>

                                <!-- Windows Explorer Context Menu -->
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsWindows}">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Windows Context Menu (Fujifier)" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="4" Padding="5,1" 
                                                    IsVisible="{Binding !IsPro}" VerticalAlignment="Center">
                                                <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Adds 'Fujifier' cascading options to right-click menu on RAW files for direct processing and queueing" FontSize="11"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsWindowsContextMenuEnabled}" OnContent="" OffContent=""/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- License & Plan Card -->
                        <TextBlock Text="License &amp; Plan" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,16,0,8"/>
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding LicenseStatusText}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                            <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="4" Padding="6,1" IsVisible="{Binding IsPro}" VerticalAlignment="Center">
                                                <TextBlock Text="PRO ACTIVE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LicenseDescriptionText}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="⭐ Get Fujifier Pro" Command="{Binding UpgradeToProCommand}" Classes="accent" IsVisible="{Binding !IsPro}" Height="32" Padding="12,0" CornerRadius="8" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Deactivate Device" Command="{Binding DeactivateLicenseCommand}" IsVisible="{Binding IsPro}" Height="32" Padding="12,0" CornerRadius="8" VerticalContentAlignment="Center"/>
                                </Grid>

                                <!-- Activation Options when in Free Tier -->
                                <StackPanel Spacing="10" IsVisible="{Binding !IsPro}">
                                    <Separator Height="1" Background="{DynamicResource AppSurfaceSecondaryBrush}"/>
                                    
                                    <!-- Tabs for Activation Mode: Key vs Account -->
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <RadioButton Content="Enter License Key" IsChecked="{Binding IsKeyTabActive, Mode=OneWay}" Command="{Binding SetKeyTabCommand}" GroupName="ActivationMode" FontSize="12"/>
                                        <RadioButton Content="Sign In to Fujifier Account" IsChecked="{Binding IsAccountTabActive, Mode=OneWay}" Command="{Binding SetAccountTabCommand}" GroupName="ActivationMode" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Option A: Direct License Key Input -->
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsKeyTabActive}">
                                        <TextBox Grid.Column="0" Text="{Binding LicenseKeyInput, Mode=TwoWay}" Watermark="Enter license key (FUJI-XXXX-XXXX-XXXX)" Height="32" CornerRadius="8" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="Activate Key" Command="{Binding ActivateLicenseCommand}" Classes="accent" Height="32" Padding="14,0" CornerRadius="8" VerticalContentAlignment="Center"/>
                                    </Grid>

                                    <!-- Option B: Account Sign In -->
                                    <StackPanel Spacing="8" IsVisible="{Binding IsAccountTabActive}">
                                        <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                            <TextBox Grid.Column="0" Text="{Binding AccountEmailInput, Mode=TwoWay}" Watermark="Account Email" Height="32" CornerRadius="8" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding AccountPasswordInput, Mode=TwoWay}" PasswordChar="●" Watermark="Account Password" Height="32" CornerRadius="8" FontSize="12" VerticalContentAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                        <Button Content="Sign In &amp; Activate License" Command="{Binding AccountLoginCommand}" Classes="accent" HorizontalAlignment="Right" Height="32" Padding="14,0" CornerRadius="8" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Live Status Feedback Message -->
                                <TextBlock Text="{Binding LicenseMessageText}" FontSize="11" Foreground="{Binding LicenseMessageColor}" IsVisible="{Binding HasLicenseMessage}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4. UPDATES -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="UPDATES" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" LetterSpacing="1" Margin="2,0"/>
                        <Border Background="{DynamicResource AppSurfaceBrush}" 
                                CornerRadius="14" Padding="16" BorderThickness="0">
                            <StackPanel Spacing="12">
                                <!-- Check on startup toggle -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Check for Updates on Startup" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="Automatically check GitHub releases when Fujifier opens" FontSize="11"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckForUpdatesOnStartup}" OnContent="" OffContent=""/>
                                </Grid>

                                <Separator Height="1" Background="{DynamicResource AppSurfaceSecondaryBrush}"/>

                                <!-- Manual Check Button -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding CurrentAppVersionText}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding UpdateStatusMessage}" FontSize="11"
                                                   Foreground="{Binding UpdateStatusColor}"
                                                   IsVisible="{Binding HasUpdateStatusMessage}"/>
                                        <TextBlock Text="Check GitHub releases for the latest updates &amp; improvements" FontSize="11"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   IsVisible="{Binding !HasUpdateStatusMessage}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Check Now" Command="{Binding CheckForUpdatesCommand}"
                                            IsEnabled="{Binding !IsCheckingForUpdate}"
                                            Classes="accent" Height="32" Padding="14,0" CornerRadius="8"
                                            VerticalContentAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="90" Height="36" CornerRadius="10"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" Width="90" Height="36" CornerRadius="10"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
