<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Fujify.Localization"
        x:Class="Fujify.Views.AboutWindow"
        Title="{loc:Loc AboutFujifier}"
        Width="440" Height="470"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Icon="/Assets/images/logo.ico">

    <!-- Standalone Dialog Card Block -->
    <Border Classes="dialog-card"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppEdgeBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22"
            ClipToBounds="True"
            PointerPressed="Window_PointerPressed">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header with Logo and Close X -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <Image Source="/Assets/images/logoXL.png" Width="52" Height="52" HorizontalAlignment="Center"/>
                    <TextBlock Text="Fujifier" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Version 2.1.0 (Cross-Platform)" FontSize="11" 
                               Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click"
                        Width="28" Height="28" CornerRadius="14" Padding="0"
                        Background="Transparent" Foreground="{DynamicResource AppTextSecondaryBrush}"
                        BorderThickness="0" Cursor="Hand" ToolTip.Tip="{loc:Loc Close}"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#22FFFFFF"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </Style>
                    </Button.Styles>
                    <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Information Content -->
            <Border Grid.Row="1" Background="{DynamicResource AppSurfaceSecondaryBrush}" 
                    BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="9">
                        <TextBlock Text="{loc:Loc AboutSubheader}" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Loc AboutDescription}"
                                   FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                        
                        <Separator Margin="0,2" Background="{DynamicResource AppEdgeBrush}"/>

                        <!-- Functional Link Buttons -->
                        <Grid ColumnDefinitions="*,*,*">
                            <Button Grid.Column="0" Content="{loc:Loc Website}" Click="Website_Click" Classes="secondary"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    FontSize="11" Height="30" Padding="0" CornerRadius="15" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="GitHub" Click="GitHub_Click" Classes="secondary"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    FontSize="11" Height="30" Padding="0" CornerRadius="15" Margin="2,0,2,0"/>
                            <Button Grid.Column="2" Content="{loc:Loc Updates}" Click="Releases_Click" Classes="secondary"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    FontSize="11" Height="30" Padding="0" CornerRadius="15" Margin="4,0,0,0"/>
                        </Grid>

                        <Separator Margin="0,2" Background="{DynamicResource AppEdgeBrush}"/>

                        <!-- Camera Compatibility -->
                        <TextBlock Text="{loc:Loc CameraCompatibility}" FontWeight="SemiBold" FontSize="11.5"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                        <TextBlock Text="{loc:Loc NonWorkingCameras}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppDangerBrush}"/>
                        <StackPanel Margin="6,0,0,0" Spacing="2">
                            <TextBlock Text="• Canon G1" FontSize="9.5" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <TextBlock Text="• Nikon e5700" FontSize="9.5" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                            <TextBlock Text="• Canon PowerShot Pro70" FontSize="9.5" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc PartiallyWorkingCameras}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccentLightBrush}" Margin="0,2,0,0"/>
                        <StackPanel Margin="6,0,0,0" Spacing="2">
                            <TextBlock Text="• Hasselblad Flash sync" FontSize="9.5" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        </StackPanel>

                        <Separator Margin="0,2" Background="{DynamicResource AppEdgeBrush}"/>

                        <TextBlock Text="{loc:Loc DevelopedBy}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <TextBlock Text="{loc:Loc PoweredBy}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <TextBlock Text="{loc:Loc LicenseGpl}" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Button Grid.Row="2" Content="{loc:Loc Close}" Click="Close_Click" Classes="primary" Height="34" Width="90" Padding="0" CornerRadius="17"
                    HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,14,0,0"/>
        </Grid>
    </Border>
</Window>
