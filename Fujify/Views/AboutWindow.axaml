<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Fujify.Views.AboutWindow"
        Title="About Fujifier"
        Width="440" Height="470"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Icon="/Assets/images/logo.ico">

    <!-- Standalone Dialog Card Block -->
    <Border Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppEdgeBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22"
            ClipToBounds="True"
            PointerPressed="Window_PointerPressed">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header with Logo and Close X -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <Image Source="/Assets/images/logoXL.png" Width="52" Height="52" HorizontalAlignment="Center"/>
                    <TextBlock Text="Fujifier" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Version 2.1.0 (Cross-Platform)" FontSize="11" 
                               Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click"
                        Width="28" Height="28" CornerRadius="14" Padding="0"
                        Background="Transparent" Foreground="{DynamicResource AppTextSecondaryBrush}"
                        BorderThickness="0" Cursor="Hand" ToolTip.Tip="Close"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#22FFFFFF"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </Style>
                    </Button.Styles>
                    <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Information Content -->
            <Border Grid.Row="1" Background="{DynamicResource AppSurfaceSecondaryBrush}" 
                    BorderBrush="{DynamicResource AppEdgeBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14">
                <StackPanel Spacing="9">
                    <TextBlock Text="Fujifilm Film Simulation Profiles for All Cameras" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Converts camera RAW images to DNG while embedding Fujifilm camera profiles and metadata so Adobe Lightroom and Camera Raw (ACR) can apply authentic Fujifilm film simulations."
                               FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                    
                    <Separator Margin="0,2" Background="{DynamicResource AppEdgeBrush}"/>

                    <!-- Functional Link Buttons -->
                    <Grid ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0" Content="Website" Click="Website_Click" Classes="secondary"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                FontSize="11" Height="30" Padding="0" CornerRadius="15" Margin="0,0,4,0"/>
                        <Button Grid.Column="1" Content="GitHub" Click="GitHub_Click" Classes="secondary"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                FontSize="11" Height="30" Padding="0" CornerRadius="15" Margin="2,0,2,0"/>
                        <Button Grid.Column="2" Content="Updates" Click="Releases_Click" Classes="secondary"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                FontSize="11" Height="30" Padding="0" CornerRadius="15" Margin="4,0,0,0"/>
                    </Grid>

                    <Separator Margin="0,2" Background="{DynamicResource AppEdgeBrush}"/>

                    <TextBlock Text="Developed by Isidore Paulin (ipweb.dev)" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="Powered by: DNGLab, ExifTool, Avalonia UI" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="Licensed under GNU General Public License v3" FontSize="10" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Button Grid.Row="2" Content="Close" Click="Close_Click" Classes="primary" Height="34" Width="90" Padding="0" CornerRadius="17"
                    HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,14,0,0"/>
        </Grid>
    </Border>
</Window>
