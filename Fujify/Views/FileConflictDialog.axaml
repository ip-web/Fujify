<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fujify.ViewModels"
        x:Class="Fujify.Views.FileConflictDialog"
        x:DataType="vm:FileConflictDialogViewModel"
        Title="File Conflict"
        Width="480" Height="300"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="Mica, AcrylicBlur"
        Background="Transparent"
        Icon="/Assets/images/logo.ico">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto">
            <!-- Title and Icon -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                <Border Width="36" Height="36" CornerRadius="18" Background="#3A3226">
                    <TextBlock Text="⚠" FontSize="18" Foreground="#F39C12" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Destination File Exists" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                    <TextBlock Text="A file with this name already exists in the destination folder." 
                               Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
            </StackPanel>

            <!-- File Details -->
            <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" 
                    CornerRadius="10" Padding="12" Margin="0,0,0,16" BorderThickness="0">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DirectoryPath}" FontSize="11" 
                               Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Apply to All Checkbox -->
            <CheckBox Grid.Row="2" Content="Apply for all the pictures on the queue" 
                      IsChecked="{Binding ApplyToAll}" Margin="0,0,0,16"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Skip" Command="{Binding SkipCommand}" Width="85" Height="36" CornerRadius="10"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="Use Unique Name" Command="{Binding UseUniqueNameCommand}" Width="150" Height="36" CornerRadius="10"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="Overwrite" Command="{Binding OverwriteCommand}" Classes="accent" Width="100" Height="36" CornerRadius="10"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
