<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <ApplicationId>com.ipweb.fujifier</ApplicationId>
    <ApplicationTitle>Fujifier</ApplicationTitle>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">5</ApplicationVersion>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">2.0.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseFastDeployment>false</AndroidUseFastDeployment>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="3.119.4" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Android" Version="8.3.1.5" />
    <PackageReference Include="Xamarin.GooglePlayServices.Ads.Lite" Version="124.0.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fujify\Fujify.csproj" Properties="OutputType=Library;TargetFramework=net10.0" />
  </ItemGroup>
</Project>
