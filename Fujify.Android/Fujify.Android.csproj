<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(OS)' == 'Windows_NT'">net9.0-android36.0</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <ApplicationId>com.ipweb.fujifier</ApplicationId>
    <ApplicationTitle>Fujifier</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>2.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.2.8" />
    <PackageReference Include="Xamarin.GooglePlayServices.Ads.Lite" Version="124.0.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fujify\Fujify.csproj" Properties="OutputType=Library;TargetFramework=net9.0" Condition="'$(TargetFramework)' == 'net9.0-android36.0' or '$(TargetFramework)' == 'net9.0-android'" />
    <ProjectReference Include="..\Fujify\Fujify.csproj" Properties="OutputType=Library;TargetFramework=net10.0" Condition="'$(TargetFramework)' != 'net9.0-android36.0' and '$(TargetFramework)' != 'net9.0-android'" />
  </ItemGroup>
</Project>
