<UserControl x:Class="FujifyNET.FileConflictDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:FujifyNET"
             Width="440" Height="Auto"
             TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
             Background="{DynamicResource MaterialDesign.Brush.Background}"
             TextElement.FontWeight="Medium"
             TextElement.FontSize="14"
             FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto">
    <Grid VerticalAlignment="Center">
        <Border Background="{DynamicResource MaterialDesign.Brush.Background}" 
                Padding="20,16,20,16" 
                CornerRadius="8" 
                materialDesign:ElevationAssist.Elevation="Dp8">
            <StackPanel>
                <!-- Title & Alert Icon -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#FFA000" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="File Already Exists" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- File Details -->
                <TextBlock Text="{Binding FileName}" 
                           FontWeight="Bold" 
                           FontSize="14" 
                           TextAlignment="Center" 
                           TextWrapping="Wrap" 
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" 
                           Margin="0,0,0,2"/>

                <TextBlock Text="{Binding DirectoryPath}" 
                           FontSize="11" 
                           TextAlignment="Center" 
                           TextWrapping="Wrap" 
                           Foreground="{DynamicResource MaterialDesignBodyLight}" 
                           Margin="0,0,0,10"/>

                <TextBlock Text="The destination already contains a file with this name." 
                           TextWrapping="Wrap" 
                           TextAlignment="Center" 
                           FontSize="13" 
                           Margin="0,0,0,14"/>

                <!-- Apply to all checkbox (Windows copy style) -->
                <CheckBox Content="Apply for all the pictures on the queue" 
                          IsChecked="{Binding ApplyToAll, Mode=TwoWay}"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,16"
                          FontSize="13"/>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Overwrite" 
                            Command="{Binding OverwriteCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Margin="4" 
                            MinWidth="100" 
                            Height="36" />
                    <Button Content="Use Unique Name" 
                            Command="{Binding UseUniqueNameCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Margin="4" 
                            MinWidth="145" 
                            Height="36" />
                    <Button Content="Skip" 
                            Command="{Binding SkipCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Margin="4" 
                            MinWidth="85" 
                            Height="36" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
