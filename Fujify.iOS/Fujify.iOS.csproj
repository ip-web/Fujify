<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-ios;net9.0-ios</TargetFrameworks>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationTitle>Fujifier</ApplicationTitle>
    <ApplicationId>com.ipweb.fujifier</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>2.1.0</ApplicationDisplayVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableCodeSigning>false</EnableCodeSigning>
    <CodesignKey>-</CodesignKey>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <_SuppressXcodeRequirementCheck>true</_SuppressXcodeRequirementCheck>
    <Registrar>dynamic</Registrar>
    <DynamicRegistrationSupported>true</DynamicRegistrationSupported>
    <MtouchEnableDsym>false</MtouchEnableDsym>
    <_TaskAssemblyFileNameWindows Condition="'$(OS)' == 'Windows_NT' and '$(_TaskAssemblyFileNameWindows)' == ''">C:\Program Files\dotnet\packs\Microsoft.iOS.Windows.Sdk.net10.0_26.0\26.0.11017\tools\msbuild\iOS\Xamarin.iOS.Tasks.Windows.dll</_TaskAssemblyFileNameWindows>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="11.2.8" />
  </ItemGroup>

  <ItemGroup>
    <InterfaceDefinition Include="Resources\LaunchScreen.storyboard" />
    <BundleResource Include="Resources\**\*" Exclude="Resources\LaunchScreen.storyboard" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fujify\Fujify.csproj" Properties="OutputType=Library;TargetFramework=net9.0" Condition="'$(TargetFramework)' == 'net9.0-ios'" />
    <ProjectReference Include="..\Fujify\Fujify.csproj" Properties="OutputType=Library;TargetFramework=net10.0" Condition="'$(TargetFramework)' != 'net9.0-ios'" />
  </ItemGroup>
</Project>
