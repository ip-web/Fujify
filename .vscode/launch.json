{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Debugger (launch)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/Fujify/bin/Debug/net10.0/win-x64/Fujifier.exe",
            "cwd": "${workspaceFolder}/Fujify",
            "env": {
                "DOTNET_ROOT": "C:\\Program Files\\dotnet"
            },
            "preLaunchTask": "dotrush: Build",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": ".NET Core Debugger (attach)",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:dotrush.pickProcess}"
        }
    ]
}
