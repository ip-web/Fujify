{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dotrush: Build",
            "type": "process",
            "command": "C:\\Program Files\\dotnet\\dotnet.exe",
            "args": [
                "build",
                "${workspaceFolder}\\Fujify\\Fujify.csproj",
                "-c",
                "Debug",
                "-r",
                "win-x64",
                "--no-self-contained"
            ],
            "options": {
                "env": {
                    "DOTNET_ROOT": "C:\\Program Files\\dotnet"
                }
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
