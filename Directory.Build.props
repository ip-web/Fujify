<Project>
  <PropertyGroup>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' and Exists('C:\Program Files\Microsoft\jdk-17.0.20.101-hotspot')">C:\Program Files\Microsoft\jdk-17.0.20.101-hotspot</JavaSdkDirectory>
  </PropertyGroup>
</Project>
